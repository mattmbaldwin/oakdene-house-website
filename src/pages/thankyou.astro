---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import hours from '../content/opening-hours.json';
import { pageContent, fieldSource } from '../lib/pages';

// Words: src/content/pages/thankyou.yaml (edited in /admin). The office hours come from src/content/opening-hours.json.
const ID = 'thankyou';
const page = await pageContent(ID, 'thankyou');
const { seo, steps, buttons } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <section class="thankyou" aria-label="Thank you confirmation">
    <div class="container thankyou__inner">
      <div class="thankyou__icon" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h1>{page.heading}</h1>
      <p class="thankyou__sub">{page.sub}</p>
      <p class="thankyou__body"><Prose md={page.urgent} source={src('urgent')} /> {page.availabilityLead} {hours.office.availability}.</p>

      <div class="next-steps" aria-label="What happens next">
        <h2 class="next-steps__heading">{steps.heading}</h2>
        <div class="next-steps__list">
          {steps.items.map((item, i) => <>{' '}<div class="next-step">{' '}<div class="next-step__number" aria-hidden="true">{i + 1}</div>{' '}<p><Prose md={item} source={src(`steps.items.${i}`)} /></p>{' '}</div></>)}{' '}
        </div>
      </div>

      <div class="thankyou__actions">
        {buttons.map((b) => <>{' '}<a href={b.href} class={`btn btn--${b.style}`}>{b.label}</a></>)}{' '}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .thankyou {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    padding-block: 80px;
    background-color: var(--color-tint);
  }

  .thankyou__inner {
    max-width: 600px;
    text-align: center;
  }

  .thankyou__icon {
    color: var(--color-primary);
    margin-bottom: 20px;
  }

  .thankyou h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    margin-bottom: 14px;
  }

  .thankyou__sub {
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  .thankyou__body {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .thankyou__body a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .thankyou__body a:hover {
    text-decoration: underline;
  }

  /* Next steps */
  .next-steps {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 28px 32px;
    margin-bottom: 32px;
    text-align: left;
  }

  .next-steps__heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }

  .next-steps__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .next-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .next-step__number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-weight: 700;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .next-step p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
    margin-bottom: 0;
    padding-top: 4px;
  }

  .next-step a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .next-step a:hover {
    text-decoration: underline;
  }

  .thankyou__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .thankyou__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
