---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTABand from '../components/CTABand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialBlock from '../components/TestimonialBlock.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import StatsGrid from '../components/StatsGrid.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import pageText from '../content/pages/home.json';

import allTestimonials from '../content/testimonials.json';
import allFaqs from '../content/faqs.json';
import video from '../../docs/video-launch/content/video.json';

const testimonials = allTestimonials.testimonials.filter(t => t.page === 'home');
const faqs = allFaqs.homepage.slice(0, 4);

const stats = pageText.data__stats;

const services = pageText.data__services;

const pathways = pageText.data__pathways;

const steps = pageText.data__steps;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <Hero
    heading={pageText.hero__heading}
    subheading={pageText.hero__subheading}
    image="/images/hero/hero-centre-2.jpg"
    imageAlt={pageText.hero__image_alt}
    buttons={pageText.hero__buttons}
  />

  <!-- ============================================================
       QUICK PATHWAYS
       ============================================================ -->
  <section class="section" aria-labelledby="pathways-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <h2 id="pathways-heading">{pageText.quick_pathways__heading}</h2>
      </div>
      <div class="pathways-grid">
        {pathways.map(p => (
          <a href={p.href} class="pathway-card">
            <h3 class="pathway-card__title">{p.title}</h3>
            <p class="pathway-card__summary">{p.summary}</p>
            <span class="pathway-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       MISSION — SPLIT LAYOUT
       ============================================================ -->
  <section class="section section--tint" aria-labelledby="mission-heading">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <div class="section-heading">
            <h2 id="mission-heading">{pageText.mission__heading}</h2>
          </div>
          <p>{pageText.mission__text}</p>
          <p>{pageText.mission__text_2}</p>
          <p>{pageText.mission__text_3}</p>
          <div class="btn-group" style="margin-top: 28px;">
            <a href="/about/" class="btn btn--primary">{pageText.mission__button}</a>
          </div>
        </div>
        <div class="split__image">
          <img
            src="/images/hero/hero-centre-3-with-people.jpg"
            alt={pageText.mission__image_alt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS
       ============================================================ -->
  <section class="section section--dark" aria-label="Our impact in numbers">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.stats__eyebrow}</p>
        <h2>{pageText.stats__heading}</h2>
      </div>
      <StatsGrid stats={stats} />
      <p class="stats-note">{pageText.stats__text}</p>
    </div>
  </section>

  <!-- ============================================================
       SERVICES PREVIEW
       ============================================================ -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.services_preview__eyebrow}</p>
        <h2 id="services-heading">{pageText.services_preview__heading}</h2>
      </div>
      <div class="card-grid services-grid">
        {services.map(s => (
          <ServiceCard
            title={s.title}
            summary={s.summary}
            href={s.href}
            image={s.image}
            imageAlt={s.imageAlt}
          />
        ))}
      </div>
      <div class="section-action">
        <a href="/services/" class="btn btn--secondary">{pageText.services_preview__button}</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW WE HELP — STEPS
       ============================================================ -->
  <section class="section section--tint" aria-labelledby="steps-heading">
    <div class="container">
      <div class="split split--image-right">
        <div class="split__image">
          <img
            src="/images/centre/interior-interior-2-img_2656-with-people.jpg"
            alt={pageText.how_we_help__image_alt}
            loading="lazy"
          />
        </div>
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.how_we_help__eyebrow}</p>
            <h2 id="steps-heading">{pageText.how_we_help__heading}</h2>
          </div>
          <ol class="steps" aria-label="How support works at Oakdene">
            {steps.map(step => (
              <li class="step">
                <div class="step__number" aria-hidden="true">{step.number}</div>
                <div class="step__content">
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TESTIMONIALS
       ============================================================ -->
  <section class="section" aria-labelledby="testimonials-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.testimonials__eyebrow}</p>
        <h2 id="testimonials-heading">{pageText.testimonials__heading}</h2>
      </div>
      <TestimonialBlock quotes={testimonials} />
    </div>
  </section>

  <!-- ============================================================
       FAQS
       ============================================================ -->
  <section class="section section--tint" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.faqs__eyebrow}</p>
        <h2 id="faq-heading">{pageText.faqs__heading}</h2>
      </div>
      <FAQAccordion faqs={faqs} />
    </div>
  </section>

  <!-- ============================================================
       VIDEO
       ============================================================ -->
  <section class="section" aria-labelledby="video-heading">
    <div class="container video-container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.video__eyebrow}</p>
        <h2 id="video-heading">{pageText.video__heading}</h2>
        <p class="section-heading__lead">{pageText.video__intro}</p>
      </div>
      <VideoPlayer
        youtubeId={video.youtube_id}
        title={video.title}
        thumbnail={video.thumbnail_path.replace(/^public/, '')}
        label={pageText.video__label}
      />
      <div class="section-action">
        <a href={video.watch_page_path} class="btn btn--secondary" id="video-transcript-link">{pageText.video__button}</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA
       ============================================================ -->
  <CTABand
    heading={pageText.final_cta__heading}
    subheading={pageText.final_cta__subheading}
    primaryBtn={pageText.final_cta__primarybtn}
    secondaryBtn={pageText.final_cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<script>
  import { trackEvent, videoLocation } from '../scripts/analytics';

  document.getElementById('video-transcript-link')?.addEventListener('click', () => {
    trackEvent('video_transcript_click', { video_location: videoLocation() });
  });
</script>

<style>
  /* ---- Pathways grid ---- */
  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .pathway-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    text-decoration: none;
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
    position: relative;
  }

  .pathway-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .pathway-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .pathway-card__summary {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 20px;
  }

  .pathway-card__arrow {
    font-size: 1.25rem;
    color: var(--color-primary);
    transition: transform var(--transition);
    display: inline-block;
  }

  .pathway-card:hover .pathway-card__arrow {
    transform: translateX(5px);
  }

  /* ---- Section action (centered button below grid) ---- */
  .section-action {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }

  /* ---- Services 2x2 grid ---- */
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Stats supporting note ---- */
  .stats-note {
    text-align: center;
    color: var(--color-white);
    opacity: 0.85;
    margin-top: 28px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* ---- Video section width ---- */
  .video-container {
    max-width: 880px;
  }

  /* ---- FAQ max-width ---- */
  .faq-container {
    max-width: 820px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .pathways-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pathways-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
