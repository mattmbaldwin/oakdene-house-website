---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTABand from '../components/CTABand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialBlock from '../components/TestimonialBlock.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import StatsGrid from '../components/StatsGrid.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import Prose from '../components/Prose.astro';

import allTestimonials from '../content/testimonials.json';
import hours from '../content/opening-hours.json';
import faqsYaml from '../content/faqs.yaml?raw';
import { loadFaqs, homeFaqs } from '../lib/faqs.ts';
import { pageContent, fieldSource } from '../lib/pages';
import video from '../../docs/video-launch/content/video.json';

// Words and images: src/content/pages/index.yaml (edited in /admin).
const ID = 'index';
const page = await pageContent(ID, 'home');
const { seo, hero, pathways, mission, impact, services: svc, steps, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const testimonials = allTestimonials.filter(t => t.page === 'home');
const faqs = homeFaqs(loadFaqs(faqsYaml));

const stats = impact.stats;

const services = [
  { ...svc.counselling, summary: svc.counselling.summary },
  { ...svc.lifeChoices, summary: svc.lifeChoices.summary },
  { ...svc.kitchen, summary: `${svc.kitchen.summary} ${hours.kitchen.homeSummary}.` },
  { ...svc.boutique, summary: svc.boutique.summary },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <Hero
    heading={hero.heading}
    subheading={hero.subheading}
    image={hero.image.src}
    imageAlt={hero.image.alt}
    buttons={hero.buttons.map(b => ({ text: b.label, href: b.href, variant: b.style }))}
  />

  <!-- ============================================================
       QUICK PATHWAYS
       ============================================================ -->
  <section class="section" aria-labelledby="pathways-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <h2 id="pathways-heading">{pathways.heading}</h2>
      </div>
      <div class="pathways-grid">
        {pathways.items.map(p => (
          <a href={p.href} class="pathway-card">
            <h3 class="pathway-card__title">{p.title}</h3>
            <p class="pathway-card__summary">{p.summary}</p>
            <span class="pathway-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       MISSION — SPLIT LAYOUT
       ============================================================ -->
  <section class="section section--tint" aria-labelledby="mission-heading">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <div class="section-heading">
            <h2 id="mission-heading">{mission.heading}</h2>
          </div>
          {mission.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`mission.paragraphs.${i}`)} /></p></>)}
          <div class="btn-group" style="margin-top: 28px;">
            <a href={mission.button.href} class="btn btn--primary">{mission.button.label}</a>
          </div>
        </div>
        <div class="split__image">
          <img
            src={mission.image.src}
            alt={mission.image.alt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STATS
       ============================================================ -->
  <section class="section section--dark" aria-label={impact.ariaLabel}>
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{impact.eyebrow}</p>
        <h2>{impact.heading}</h2>
      </div>
      <StatsGrid stats={stats} />
      <p class="stats-note">{impact.note}</p>
    </div>
  </section>

  <!-- ============================================================
       SERVICES PREVIEW
       ============================================================ -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{svc.heading.eyebrow}</p>
        <h2 id="services-heading">{svc.heading.heading}</h2>
      </div>
      <div class="card-grid services-grid">
        {services.map(s => (
          <ServiceCard
            title={s.title}
            summary={s.summary}
            href={s.href}
            image={s.image.src}
            imageAlt={s.image.alt}
          />
        ))}
      </div>
      <div class="section-action">
        <a href={svc.button.href} class="btn btn--secondary">{svc.button.label}</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       HOW WE HELP — STEPS
       ============================================================ -->
  <section class="section section--tint" aria-labelledby="steps-heading">
    <div class="container">
      <div class="split split--image-right">
        <div class="split__image">
          <img
            src={steps.image.src}
            alt={steps.image.alt}
            loading="lazy"
          />
        </div>
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{steps.heading.eyebrow}</p>
            <h2 id="steps-heading">{steps.heading.heading}</h2>
          </div>
          <ol class="steps" aria-label={steps.listLabel}>
            {steps.items.map((step, i) => (
              <li class="step">
                <div class="step__number" aria-hidden="true">{i + 1}</div>
                <div class="step__content">
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TESTIMONIALS
       ============================================================ -->
  <section class="section" aria-labelledby="testimonials-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{page.testimonials.heading.eyebrow}</p>
        <h2 id="testimonials-heading">{page.testimonials.heading.heading}</h2>
      </div>
      <TestimonialBlock quotes={testimonials} />
    </div>
  </section>

  <!-- ============================================================
       FAQS
       ============================================================ -->
  <section class="section section--tint" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{page.faq.heading.eyebrow}</p>
        <h2 id="faq-heading">{page.faq.heading.heading}</h2>
      </div>
      <FAQAccordion faqs={faqs} />
    </div>
  </section>

  <!-- ============================================================
       VIDEO
       ============================================================ -->
  <section class="section" aria-labelledby="video-heading">
    <div class="container video-container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{page.video.heading.eyebrow}</p>
        <h2 id="video-heading">{page.video.heading.heading}</h2>
        <p class="section-heading__lead"><Prose md={page.video.heading.lead} source={src('video.heading.lead')} /></p>
      </div>
      <VideoPlayer
        youtubeId={video.youtube_id}
        title={video.title}
        thumbnail={video.thumbnail_path.replace(/^public/, '')}
        label={page.video.playLabel}
      />
      <div class="section-action">
        <a href={video.watch_page_path} class="btn btn--secondary" id="video-transcript-link">{page.video.transcriptLabel}</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA
       ============================================================ -->
  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<script>
  import { trackEvent, videoLocation } from '../scripts/analytics';

  document.getElementById('video-transcript-link')?.addEventListener('click', () => {
    trackEvent('video_transcript_click', { video_location: videoLocation() });
  });
</script>

<style>
  /* ---- Pathways grid ---- */
  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .pathway-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    text-decoration: none;
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
    position: relative;
  }

  .pathway-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .pathway-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .pathway-card__summary {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 20px;
  }

  .pathway-card__arrow {
    font-size: 1.25rem;
    color: var(--color-primary);
    transition: transform var(--transition);
    display: inline-block;
  }

  .pathway-card:hover .pathway-card__arrow {
    transform: translateX(5px);
  }

  /* ---- Section action (centered button below grid) ---- */
  .section-action {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }

  /* ---- Services 2x2 grid ---- */
  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Stats supporting note ---- */
  .stats-note {
    text-align: center;
    color: var(--color-white);
    opacity: 0.85;
    margin-top: 28px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* ---- Video section width ---- */
  .video-container {
    max-width: 880px;
  }

  /* ---- FAQ max-width ---- */
  .faq-container {
    max-width: 820px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .pathways-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .pathways-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
