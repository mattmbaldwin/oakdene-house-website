---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Prose from '../../../components/Prose.astro';
import { pageContent, fieldSource } from '../../../lib/pages';

// Words and images: src/content/pages/services--referral--thank-you.yaml (edited in /admin).
const ID = 'services--referral--thank-you';
const page = await pageContent(ID, 'referral-thank-you');
const { seo, hero, body } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="ty-hero" aria-label="Referral received">
    <div class="ty-hero__overlay" aria-hidden="true"></div>
    <div class="container ty-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/referral/">{hero.parentBreadcrumb}</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="section" aria-label="What happens next">
    <div class="container">
      <div class="ty-body">
        <p><Prose md={body.text} source={src('body.text')} /></p>
        <div class="ty-actions">
          <a href={body.primary.href} class={`btn btn--${body.primary.style}`}>{body.primary.label}</a>
          <a href={body.secondary.href} class={`btn btn--${body.secondary.style}`}>{body.secondary.label}</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .ty-hero {
    position: relative;
    min-height: 320px;
    background-image: url('/images/generic/bandw-forset-sun-beam.jpeg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .ty-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.4) 0%, rgba(0,62,81,0.88) 100%);
  }

  .ty-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
    max-width: 740px;
  }

  .ty-hero__content h1 {
    color: var(--color-white);
    margin-top: 16px;
    margin-bottom: 0;
  }

  .ty-body {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    padding-block: 20px;
  }

  .ty-body p {
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .ty-body a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .ty-body a:hover {
    color: var(--color-primary-hover);
  }

  .ty-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .ty-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
