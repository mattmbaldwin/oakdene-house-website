---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import { renderProse } from '../../lib/prose';
import Prose from '../../components/Prose.astro';
import { pageContent, fieldSource } from '../../lib/pages';

// Words and images: src/content/pages/services--financial-counselling.yaml (edited in /admin).
const ID = 'services--financial-counselling';
const page = await pageContent(ID, 'financial-counselling');
const { seo, hero, overview, approach, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const serviceRows = overview.details.rows.map((r, i) => ({
  label: r.label,
  value: renderProse(r.value, src(`overview.details.rows.${i}.value`)),
}));

---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="fc-hero" aria-label="Financial Counselling">
    <div class="fc-hero__overlay" aria-hidden="true"></div>
    <div class="container fc-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="fc-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="fc-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{overview.heading.eyebrow}</p>
            <h2 id="fc-overview-heading">{overview.heading.heading}</h2>
          </div>
          {overview.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`overview.paragraphs.${i}`)} /></p></>)}

          <h3 class="section-subhead">{overview.helpHeading}</h3>

          <ul class="offer-list">
            {overview.helpItems.map((item, i) => <>{i > 0 && ' '}<li><Prose md={item} source={src(`overview.helpItems.${i}`)} /></li></>)}
          </ul>

          <div class="access-note">
            <h3>{overview.access.heading}</h3>
            <p><Prose md={overview.access.text} source={src('overview.access.text')} /></p>
            <div class="btn-group">
              <a href={overview.access.primary.href} class={`btn btn--${overview.access.primary.style}`}>{overview.access.primary.label}</a><!-- TODO: Replace with live Jotform URL -->
              <a href={overview.access.secondary.href} class={`btn btn--${overview.access.secondary.style}`}>{overview.access.secondary.label}</a>
            </div>
          </div>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={overview.details.caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- OUR APPROACH + FCA ACCREDITATION -->
  <section class="section section--tint" aria-labelledby="approach-heading">
    <div class="container">
      <div class="what-inner">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{approach.heading.eyebrow}</p>
          <h2 id="approach-heading">{approach.heading.heading}</h2>
        </div>

        <div class="approach-content">
          {approach.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`approach.paragraphs.${i}`)} /></p></>)}

          <h3 class="section-subhead">{approach.qualifiedHeading}</h3>

          {approach.qualifiedParagraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`approach.qualifiedParagraphs.${i}`)} /></p></>)}

          <div class="fca-credit">
            <p>{approach.accredited.text}</p>
            <img src={approach.accredited.logo.src} alt={approach.accredited.logo.alt} class="fca-credit__logo" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .fc-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/generic/colour-business-man_distress.png');
    background-size: cover;
    background-position: center top;
    display: flex;
    align-items: flex-end;
  }

  .fc-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.5) 0%, rgba(0,62,81,0.92) 100%);
  }

  .fc-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .fc-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .fc-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .section-subhead {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    margin-bottom: 28px;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .access-note {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
  }

  .access-note h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .access-note p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  /* Approach section */
  .what-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .approach-content p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .approach-content p:last-of-type {
    margin-bottom: 0;
  }

  /* FCA accreditation credit */
  .fca-credit {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .fca-credit p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    font-weight: 500;
  }

  .fca-credit__logo {
    height: 70px;
    width: auto;
    display: block;
  }
</style>
