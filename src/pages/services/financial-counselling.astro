---
import programs from '../../content/programs.json';
import { inline } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import pageText from '../../content/pages/services-financial-counselling.json';

const serviceRows = programs.financial_counselling.rows.map((row) => ({ label: row.label, value: inline(row.value) }));

---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/generic/colour-business-man_distress.jpg"
>

  <!-- HERO -->
  <section class="fc-hero" aria-label="Financial Counselling">
    <div class="fc-hero__overlay" aria-hidden="true"></div>
    <div class="container fc-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Financial Counselling</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="fc-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="fc-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.overview__eyebrow}</p>
            <h2 id="fc-overview-heading">{pageText.overview__heading}</h2>
          </div>
          <p>{pageText.overview__text}</p>

          <p>{pageText.overview__text_2}</p>

          <p>{pageText.overview__text_3}</p>

          <h3 class="section-subhead">{pageText.overview__subheading}</h3>

          <ul class="offer-list">
{pageText.overview__list.map((item) => <li>{item}</li>)}
</ul>

          <div class="access-note">
            <h3>{pageText.overview__subheading_2}</h3>
            <p>{pageText.overview__text_4}</p>
            <div class="btn-group">
              <a href="/services/referral/" class="btn btn--primary">{pageText.overview__button}</a><!-- TODO: Replace with live Jotform URL -->
              <a href="/contact/" class="btn btn--secondary">{pageText.overview__button_2}</a>
            </div>
          </div>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={pageText.overview__caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- OUR APPROACH + FCA ACCREDITATION -->
  <section class="section section--tint" aria-labelledby="approach-heading">
    <div class="container">
      <div class="what-inner">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{pageText.our_approach_fca_accreditation__eyebrow}</p>
          <h2 id="approach-heading">{pageText.our_approach_fca_accreditation__heading}</h2>
        </div>

        <div class="approach-content">
          <p>{pageText.our_approach_fca_accreditation__text}</p>

          <p>{pageText.our_approach_fca_accreditation__text_2}</p>

          <h3 class="section-subhead">{pageText.our_approach_fca_accreditation__subheading}</h3>

          <p>{pageText.our_approach_fca_accreditation__text_3}</p>

          <p>{pageText.our_approach_fca_accreditation__text_4}</p>

          <div class="fca-credit">
            <p>{pageText.our_approach_fca_accreditation__text_5}</p>
            <img src="/images/logos/partners/fca-logo-slim.png" alt={pageText.our_approach_fca_accreditation__image_alt} class="fca-credit__logo" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    subheading={pageText.cta__subheading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .fc-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/generic/colour-business-man_distress.jpg');
    background-size: cover;
    background-position: center top;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .fc-hero {
      background-image: url('/images/generic/colour-business-man_distress-1080.jpg');
    }
  }

  .fc-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.5) 0%, rgba(0,62,81,0.92) 100%);
  }

  .fc-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .fc-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .fc-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .section-subhead {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    margin-bottom: 28px;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .access-note {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
  }

  .access-note h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .access-note p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  /* Approach section */
  .what-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .approach-content p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .approach-content p:last-of-type {
    margin-bottom: 0;
  }

  /* FCA accreditation credit */
  .fca-credit {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .fca-credit p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    font-weight: 500;
  }

  .fca-credit__logo {
    height: 70px;
    width: auto;
    display: block;
  }
</style>
