---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageText from '../../content/pages/services-referral.json';
import { inlineMarkdown } from '../../lib/format';
import CTABand from '../../components/CTABand.astro';
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/generic/bandw-forset-sun-beam.jpeg"
>

  <!-- HERO -->
  <section class="referral-hero" aria-label="Make a Referral">
    <div class="referral-hero__overlay" aria-hidden="true"></div>
    <div class="container referral-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Make a Referral</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="referral-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section class="section" aria-label="Referral form">
    <div class="container">
      <div class="referral-layout">

        <!-- Main column -->
        <div class="referral-main">
          <p class="referral-intro" set:html={inlineMarkdown(pageText.main_column__intro)}></p>
          <p class="referral-intro referral-intro--privacy" set:html={inlineMarkdown(pageText.main_column__intro_2)}></p>

          <!-- Jotform embed — referral form ID 253010226998054 -->
          <iframe
            id="JotFormIFrame-253010226998054"
            title="Referral form — Oakdene House Foundation"
            src="https://form.jotform.com/253010226998054"
            class="jotform-embed"
            frameborder="0"
            scrolling="no"
            allow="geolocation; microphone; camera; fullscreen"
          ></iframe>
          <script is:inline src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
          <script is:inline>window.jotformEmbedHandler("iframe[id='JotFormIFrame-253010226998054']", "https://form.jotform.com/");</script>
        </div>

        <!-- Sidebar -->
        <aside class="referral-sidebar">
          <div class="urgent-box">
            <div class="urgent-box__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.09 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 5.98 5.98l1.28-1.28a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
            </div>
            <h2>{pageText.sidebar__heading}</h2>
            <p set:html={inlineMarkdown(pageText.sidebar__text)}></p>
            <a href="/need-help-now/" class="btn btn--primary btn--block">{pageText.sidebar__button}</a>
          </div>

          <div class="contact-box">
            <h2>{pageText.sidebar__heading_2}</h2>
            <p>{pageText.sidebar__text_2}</p>
            <a href="tel:0287170999" class="contact-box__phone">{pageText.sidebar__button_2}</a>
            <p class="contact-box__or">{pageText.sidebar__text_3}</p>
            <a href="mailto:admin@oakdenehouse.org.au" class="contact-box__email">{pageText.sidebar__button_3}</a>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    subheading={pageText.cta__subheading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .referral-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/generic/bandw-forset-sun-beam.jpeg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .referral-hero {
      background-image: url('/images/generic/bandw-forset-sun-beam-1080.jpeg');
    }
  }

  .referral-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.4) 0%, rgba(0,62,81,0.88) 100%);
  }

  .referral-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
    max-width: 740px;
  }

  .referral-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .referral-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    line-height: 1.6;
    margin-bottom: 0;
    max-width: 580px;
  }

  /* Two-column layout */
  .referral-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: flex-start;
  }

  /* Intro text */
  .referral-intro {
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .referral-intro :global(a) {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* Form embed */
  .jotform-embed {
    display: block;
    width: 100%;
    min-height: 539px;
    border: none;
  }

  /* Privacy sentence */
  .referral-intro--privacy {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin-top: -16px;
    margin-bottom: 28px;
  }

  .referral-intro--privacy :global(a) {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* Sidebar */
  .referral-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 96px;
  }

  /* Urgent box */
  .urgent-box {
    background-color: var(--color-primary);
    border-radius: var(--radius-card);
    padding: 28px;
    color: rgba(255,255,255,0.9);
  }

  .urgent-box__icon {
    color: rgba(255,255,255,0.7);
    margin-bottom: 14px;
  }

  .urgent-box h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .urgent-box p {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 20px;
    color: rgba(255,255,255,0.85);
  }

  .urgent-box p :global(a) {
    color: var(--color-white);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .btn--block {
    display: block;
    width: 100%;
    text-align: center;
    background-color: var(--color-white);
    color: var(--color-primary);
    border-color: var(--color-white);
  }

  .btn--block:hover {
    background-color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.9);
  }

  /* Contact box */
  .contact-box {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 24px 28px;
  }

  .contact-box h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .contact-box p {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-bottom: 14px;
    line-height: 1.5;
  }

  .contact-box__phone {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    margin-bottom: 6px;
  }

  .contact-box__phone:hover {
    color: var(--color-primary-hover);
  }

  .contact-box__or {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0 0 6px;
  }

  .contact-box__email {
    font-size: 0.9rem;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    word-break: break-all;
  }

  .contact-box__email:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .referral-layout {
      grid-template-columns: 1fr;
    }

    .referral-sidebar {
      position: static;
    }
  }
</style>
