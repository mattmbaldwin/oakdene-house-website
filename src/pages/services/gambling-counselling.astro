---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pageText from '../../content/pages/services-gambling-counselling.json';
import { inlineMarkdown } from '../../lib/format';
import CTABand from '../../components/CTABand.astro';
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/generic/bandw-distressed-woman.jpeg"
>

  <!-- HERO -->
  <section class="gc-hero" aria-label="Gambling Counselling">
    <div class="gc-hero__overlay" aria-hidden="true"></div>
    <div class="container gc-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Gambling Counselling</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="gc-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="gc-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.overview__eyebrow}</p>
            <h2 id="gc-overview-heading">{pageText.overview__heading}</h2>
          </div>
          <p>{pageText.overview__text}</p>
          <p>{pageText.overview__text_2}</p>

          <div class="service-facts">
            <div class="service-fact">
              <span class="service-fact__label">{pageText.overview__text_3}</span>
              <span class="service-fact__value">{pageText.overview__text_4}</span>
            </div>
            <div class="service-fact">
              <span class="service-fact__label">{pageText.overview__text_5}</span>
              <span class="service-fact__value">{pageText.overview__text_6}</span>
            </div>
            <div class="service-fact">
              <span class="service-fact__label">{pageText.overview__text_7}</span>
              <span class="service-fact__value">{pageText.overview__text_8}</span>
            </div>
          </div>

          <div class="contact-line">
            <a href="tel:0287170999" class="contact-phone">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.09 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 5.98 5.98l1.28-1.28a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
              (02) 8717 0999
            </a>
            <a href="mailto:admin@oakdenehouse.org.au" class="contact-email">{pageText.overview__button}</a>
          </div>
        </div>
        <div class="gc-right">
          <div class="gc-image">
            <img src="/images/gambling/gambling-counselling.jpg" alt={pageText.overview__image_alt} loading="lazy" />
          </div>
          <div class="helpline-box">
            <div class="helpline-box__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <p class="helpline-box__heading">{pageText.overview__text_9}</p>
              <p>{pageText.overview__text_10}</p>
              <a href="tel:1800858858" class="helpline-number">{pageText.overview__button_2}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE ADDRESS -->
  <section class="section section--tint" aria-labelledby="address-heading">
    <div class="container">
      <div class="address-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{pageText.what_we_address__eyebrow}</p>
          <h2 id="address-heading">{pageText.what_we_address__heading}</h2>
          <p class="section-heading__lead">{pageText.what_we_address__intro}</p>
        </div>
        <div class="impact-grid">
          <div class="impact-item">
            <h3>{pageText.what_we_address__subheading}</h3>
            <p set:html={inlineMarkdown(pageText.what_we_address__text)}></p>
          </div>
          <div class="impact-item">
            <h3>{pageText.what_we_address__subheading_2}</h3>
            <p>{pageText.what_we_address__text_2}</p>
          </div>
          <div class="impact-item">
            <h3>{pageText.what_we_address__subheading_3}</h3>
            <p>{pageText.what_we_address__text_3}</p>
          </div>
          <div class="impact-item">
            <h3>{pageText.what_we_address__subheading_4}</h3>
            <p>{pageText.what_we_address__text_4}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    subheading={pageText.cta__subheading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .gc-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/generic/bandw-distressed-woman.jpeg');
    background-size: cover;
    background-position: center top;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .gc-hero {
      background-image: url('/images/generic/bandw-distressed-woman-1080.jpeg');
    }
  }

  .gc-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.45) 0%, rgba(0,62,81,0.9) 100%);
  }

  .gc-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .gc-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .gc-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .service-facts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 28px 0;
    padding: 20px 24px;
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
  }

  .service-fact {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 8px;
    font-size: 0.9375rem;
  }

  .service-fact__label {
    font-weight: 600;
    color: var(--color-primary);
  }

  .service-fact__value {
    color: var(--color-text);
  }

  .contact-line {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .contact-phone:hover { text-decoration: underline; }

  .contact-email {
    font-size: 0.9375rem;
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .contact-email:hover { text-decoration: underline; }

  .gc-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .gc-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .gc-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .helpline-box {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    border-left: 3px solid var(--color-primary);
    padding: 20px 24px;
  }

  .helpline-box__icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .helpline-box__heading {
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .helpline-box p:nth-child(2) {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .helpline-number {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    display: block;
  }

  .helpline-number:hover { text-decoration: underline; }

  /* Impact grid */
  .address-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .impact-item {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 24px;
    border: 1px solid var(--color-secondary);
  }

  .impact-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .impact-item p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 600px) {
    .impact-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Links inside paragraph text need more than colour to stand out */
  p :global(a:not(.btn)) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
