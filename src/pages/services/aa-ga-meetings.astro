---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import pageText from '../../content/pages/services-aa-ga-meetings.json';
import { inlineMarkdown } from '../../lib/format';

const meetingTypes = pageText.data__meeting_types;

const whatToExpect = pageText.data__what_to_expect;

const gaSchedule = pageText.data__ga_schedule;

const aaSchedule = pageText.data__aa_schedule;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/centre/interior-meetings-1-img_2657.jpg"
>

  <!-- HERO -->
  <section class="aa-hero" aria-label="AA and GA Meetings">
    <div class="aa-hero__overlay" aria-hidden="true"></div>
    <div class="container aa-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">AA &amp; GA Meetings</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="aa-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="aa-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.overview__eyebrow}</p>
            <h2 id="aa-overview-heading">{pageText.overview__heading}</h2>
          </div>
          <p>{pageText.overview__text}</p>

          <h3 class="section-subhead">{pageText.overview__subheading}</h3>
          <ul class="meeting-list">
            {meetingTypes.map(m => <li>{m}</li>)}
          </ul>

          <h3 class="section-subhead">{pageText.overview__subheading_2}</h3>
          <ul class="expect-list">
            {whatToExpect.map(e => <li>{e}</li>)}
          </ul>

          <h3 class="section-subhead">{pageText.overview__subheading_3}</h3>
          <p>{pageText.overview__text_2}</p>
          <ul class="expect-list">
{pageText.overview__list.map((item) => <li set:html={inlineMarkdown(item)} />)}
</ul>
        </div>
        <div>
          <div class="meetings-image">
            <img src="/images/centre/interior-meetings-1-img_2657.jpg" alt={pageText.overview__image_alt} loading="lazy" />
          </div>
          <div class="schedule-note">
            <div class="schedule-note__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <p class="schedule-note__heading">{pageText.overview__text_3}</p>
              <p>{pageText.overview__text_4}</p>
              <div class="schedule-contact">
                <a href="tel:0287170999" class="schedule-phone">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.09 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 5.98 5.98l1.28-1.28a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
                  (02) 8717 0999
                </a>
                <a href="mailto:admin@oakdenehouse.org.au" class="schedule-email">{pageText.overview__button}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT AA AND GA -->
  <section class="section section--tint" aria-labelledby="about-heading">
    <div class="container">
      <div class="about-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{pageText.about_aa_and_ga__eyebrow}</p>
          <h2 id="about-heading">{pageText.about_aa_and_ga__heading}</h2>
        </div>
        <div class="about-grid">
          <div class="about-card">
            <h3>{pageText.about_aa_and_ga__subheading}</h3>
            <p>{pageText.about_aa_and_ga__text}</p>
            <p>{pageText.about_aa_and_ga__text_2}</p>
          </div>
          <div class="about-card">
            <h3>{pageText.about_aa_and_ga__subheading_2}</h3>
            <p>{pageText.about_aa_and_ga__text_3}</p>
            <p>{pageText.about_aa_and_ga__text_4}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MEETING SCHEDULE -->
  <section class="section section--tint meetings-schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.meeting_schedule__eyebrow}</p>
        <h2 id="schedule-heading">{pageText.meeting_schedule__heading}</h2>
        <p class="section-heading__lead">{pageText.meeting_schedule__intro}</p>
      </div>

      <div class="schedule-block">
        <h3 class="schedule-block__heading">{pageText.meeting_schedule__subheading}</h3>
        <div class="schedule-scroll">
          <div class="schedule-table-wrap">
            <table class="schedule-table" aria-label="GA meeting schedule">
              <thead>
                <tr>
                  <th scope="col">{pageText.meeting_schedule__cell}</th>
                  <th scope="col">{pageText.meeting_schedule__cell_2}</th>
                  <th scope="col">{pageText.meeting_schedule__cell_3}</th>
                </tr>
              </thead>
              <tbody>
                {gaSchedule.map(row => (
                  <tr>
                    <td>{row.day}</td>
                    <td>{row.time}</td>
                    <td>{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="schedule-block">
        <h3 class="schedule-block__heading">{pageText.meeting_schedule__subheading_2}</h3>
        <div class="schedule-scroll">
          <div class="schedule-table-wrap">
            <table class="schedule-table" aria-label="AA meeting schedule">
              <thead>
                <tr>
                  <th scope="col">{pageText.meeting_schedule__cell_4}</th>
                  <th scope="col">{pageText.meeting_schedule__cell_5}</th>
                  <th scope="col">{pageText.meeting_schedule__cell_6}</th>
                </tr>
              </thead>
              <tbody>
                {aaSchedule.map(row => (
                  <tr>
                    <td>{row.day}</td>
                    <td>{row.time}</td>
                    <td>{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .aa-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/centre/interior-meetings-1-img_2657-v2.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .aa-hero {
      background-image: url('/images/centre/interior-meetings-1-img_2657-v2-1080.jpg');
    }
  }

  .aa-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .aa-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .aa-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .aa-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .section-subhead {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .meeting-list,
  .expect-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    margin-bottom: 8px;
  }

  .meeting-list li,
  .expect-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .meeting-list li::before,
  .expect-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .meetings-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 20px;
  }

  .meetings-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .schedule-note {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    border-left: 3px solid var(--color-primary);
    padding: 20px 24px;
  }

  .schedule-note__icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .schedule-note__heading {
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .schedule-note p:nth-child(2) {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .schedule-contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .schedule-phone,
  .schedule-email {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .schedule-phone:hover,
  .schedule-email:hover { text-decoration: underline; }

  /* About grid */
  .about-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .about-card {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    border: 1px solid var(--color-secondary);
    border-top: 3px solid var(--color-primary);
  }

  .about-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .about-card p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  .about-card p:last-child {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 600px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Meeting schedule section */
  .meetings-schedule .section-heading {
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .schedule-block {
    max-width: 860px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .schedule-block:last-child {
    margin-bottom: 0;
  }

  .schedule-block__heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .schedule-scroll {
    overflow-x: auto;
  }

  .schedule-table-wrap {
    min-width: 480px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-secondary);
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    background-color: var(--color-white);
  }

  .schedule-table thead {
    background-color: var(--color-primary);
  }

  .schedule-table thead th {
    padding: 14px 20px;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  .schedule-table tbody tr {
    border-bottom: 1px solid var(--color-secondary);
  }

  .schedule-table tbody tr:last-child td {
    border-bottom: none;
  }

  .schedule-table tbody tr:nth-child(even) {
    background-color: var(--color-tint);
  }

  .schedule-table td {
    padding: 14px 20px;
    color: var(--color-text);
  }

  .schedule-table td:first-child {
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Links inside list text need more than colour to stand out */
  .expect-list :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
