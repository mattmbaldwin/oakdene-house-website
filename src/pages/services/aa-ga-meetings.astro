---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import programSchedules from '../../content/program-schedules.json';
import { formatRange, sortRows } from '../../lib/schedule';
import { pageContent, fieldSource } from '../../lib/pages';

// Words and images: src/content/pages/services--aa-ga-meetings.yaml (edited in /admin).
const ID = 'services--aa-ga-meetings';
const page = await pageContent(ID, 'aa-ga-meetings');
const { seo, hero, overview, about, cta } = page;
const note = overview.scheduleNote;
const src = (path: string) => fieldSource(ID, path);

const gaSchedule = sortRows(programSchedules.sections.ga);

const aaSchedule = sortRows(programSchedules.sections.aa);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="aa-hero" aria-label="AA and GA Meetings">
    <div class="aa-hero__overlay" aria-hidden="true"></div>
    <div class="container aa-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="aa-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="aa-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{overview.heading.eyebrow}</p>
            <h2 id="aa-overview-heading">{overview.heading.heading}</h2>
          </div>
          {overview.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`overview.paragraphs.${i}`)} /></p></>)}

          <h3 class="section-subhead">{overview.meetingsHeading}</h3>
          <ul class="meeting-list">
            {overview.meetings.map((m, i) => <li><Prose md={m} source={src(`overview.meetings.${i}`)} /></li>)}
          </ul>

          <h3 class="section-subhead">{overview.expectHeading}</h3>
          <ul class="expect-list">
            {overview.expectItems.map((e, i) => <li><Prose md={e} source={src(`overview.expectItems.${i}`)} /></li>)}
          </ul>

          <h3 class="section-subhead">{overview.helpHeading}</h3>
          <p><Prose md={overview.helpIntro} source={src('overview.helpIntro')} /></p>
          <ul class="expect-list">
            {overview.helpItems.map((item, i) => <>{i > 0 && ' '}<li><Prose md={item} source={src(`overview.helpItems.${i}`)} /></li></>)}
          </ul>
        </div>
        <div>
          <div class="meetings-image">
            <img src={overview.image.src} alt={overview.image.alt} loading="lazy" />
          </div>
          <div class="schedule-note">
            <div class="schedule-note__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <p class="schedule-note__heading">{note.heading}</p>
              <p><Prose md={note.text} source={src('overview.scheduleNote.text')} /></p>
              <div class="schedule-contact">
                <a href={note.contact.phone.href} class="schedule-phone">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.09 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 5.98 5.98l1.28-1.28a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
                  {note.contact.phone.label}
                </a>
                <a href={note.contact.email.href} class="schedule-email">{note.contact.email.label}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT AA AND GA -->
  <section class="section section--tint" aria-labelledby="about-heading">
    <div class="container">
      <div class="about-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{about.heading.eyebrow}</p>
          <h2 id="about-heading">{about.heading.heading}</h2>
        </div>
        <div class="about-grid">
          {about.cards.map((card, c) => <>{c > 0 && ' '}<div class="about-card">
            <h3>{card.heading}</h3>
            {card.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`about.cards.${c}.paragraphs.${i}`)} /></p></>)}
          </div></>)}
        </div>
      </div>
    </div>
  </section>

  <!-- MEETING SCHEDULE -->
  <section class="section section--tint meetings-schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{page.schedule.heading.eyebrow}</p>
        <h2 id="schedule-heading">{page.schedule.heading.heading}</h2>
        <p class="section-heading__lead"><Prose md={page.schedule.heading.lead} source={src('schedule.heading.lead')} /></p>
      </div>

      <div class="schedule-block">
        <h3 class="schedule-block__heading">{page.schedule.gaHeading}</h3>
        <div class="schedule-scroll">
          <div class="schedule-table-wrap">
            <table class="schedule-table" aria-label="GA meeting schedule">
              <thead>
                <tr>
                  <th scope="col">Day</th>
                  <th scope="col">Time</th>
                  <th scope="col">Notes</th>
                </tr>
              </thead>
              <tbody>
                {gaSchedule.map(row => (
                  <tr>
                    <td>{row.day}</td>
                    <td>{formatRange(row.start, row.end)}</td>
                    <td>{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="schedule-block">
        <h3 class="schedule-block__heading">{page.schedule.aaHeading}</h3>
        <div class="schedule-scroll">
          <div class="schedule-table-wrap">
            <table class="schedule-table" aria-label="AA meeting schedule">
              <thead>
                <tr>
                  <th scope="col">Day</th>
                  <th scope="col">Time</th>
                  <th scope="col">Notes</th>
                </tr>
              </thead>
              <tbody>
                {aaSchedule.map(row => (
                  <tr>
                    <td>{row.day}</td>
                    <td>{formatRange(row.start, row.end)}</td>
                    <td>{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .aa-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/centre/interior-meetings-1-img_2657-v2.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .aa-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .aa-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .aa-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .aa-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .section-subhead {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .meeting-list,
  .expect-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    margin-bottom: 8px;
  }

  .meeting-list li,
  .expect-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .meeting-list li::before,
  .expect-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .meetings-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 20px;
  }

  .meetings-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .schedule-note {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    border-left: 3px solid var(--color-primary);
    padding: 20px 24px;
  }

  .schedule-note__icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .schedule-note__heading {
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .schedule-note p:nth-child(2) {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .schedule-contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .schedule-phone,
  .schedule-email {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .schedule-phone:hover,
  .schedule-email:hover { text-decoration: underline; }

  /* About grid */
  .about-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .about-card {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    border: 1px solid var(--color-secondary);
    border-top: 3px solid var(--color-primary);
  }

  .about-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .about-card p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  .about-card p:last-child {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 600px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Meeting schedule section */
  .meetings-schedule .section-heading {
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .schedule-block {
    max-width: 860px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .schedule-block:last-child {
    margin-bottom: 0;
  }

  .schedule-block__heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .schedule-scroll {
    overflow-x: auto;
  }

  .schedule-table-wrap {
    min-width: 480px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-secondary);
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    background-color: var(--color-white);
  }

  .schedule-table thead {
    background-color: var(--color-primary);
  }

  .schedule-table thead th {
    padding: 14px 20px;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  .schedule-table tbody tr {
    border-bottom: 1px solid var(--color-secondary);
  }

  .schedule-table tbody tr:last-child td {
    border-bottom: none;
  }

  .schedule-table tbody tr:nth-child(even) {
    background-color: var(--color-tint);
  }

  .schedule-table td {
    padding: 14px 20px;
    color: var(--color-text);
  }

  .schedule-table td:first-child {
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Links inside list text need more than colour to stand out */
  .expect-list a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
