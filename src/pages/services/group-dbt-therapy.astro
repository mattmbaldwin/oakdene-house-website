---
import programs from '../../content/programs.json';
import { inline } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import pageText from '../../content/pages/services-group-dbt-therapy.json';

const serviceRows = programs.group_dbt_therapy.rows.map((row) => ({ label: row.label, value: inline(row.value) }));

const schedule = pageText.data__schedule;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/dbt/dbt-hero-photo.jpg"
>

  <!-- HERO -->
  <section class="dbt-hero" aria-label="Group DBT Therapy">
    <div class="dbt-hero__overlay" aria-hidden="true"></div>
    <div class="container dbt-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Group DBT Therapy</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="dbt-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- INTRO + SERVICE DETAILS -->
  <section class="section" aria-labelledby="dbt-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.intro_service_details__eyebrow}</p>
            <h2 id="dbt-overview-heading">{pageText.intro_service_details__heading}</h2>
          </div>
          <p>{pageText.intro_service_details__text}</p>
          <p>{pageText.intro_service_details__text_2}</p>
          <p>{pageText.intro_service_details__text_3}</p>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={pageText.intro_service_details__caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- CURRENT GROUP DETAILS -->
  <section class="section" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.current_group_details__eyebrow}</p>
        <h2 id="schedule-heading">{pageText.current_group_details__heading}</h2>
        <p class="section-heading__lead">{pageText.current_group_details__intro}</p>
      </div>
      <div class="schedule-scroll">
        <div class="schedule-table-wrap">
          <table class="schedule-table" aria-label="DBT group schedule">
            <thead>
              <tr>
                <th scope="col">{pageText.current_group_details__cell}</th>
                <th scope="col">{pageText.current_group_details__cell_2}</th>
                <th scope="col">{pageText.current_group_details__cell_3}</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map(row => (
                <tr>
                  <td>{row.day}</td>
                  <td>{row.time}</td>
                  <td>{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT THE GROUP COVERS -->
  <section class="section section--tint" aria-labelledby="skills-heading">
    <div class="container">
      <div class="skills-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{pageText.what_the_group_covers__eyebrow}</p>
          <h2 id="skills-heading">{pageText.what_the_group_covers__heading}</h2>
          <p class="section-heading__lead">{pageText.what_the_group_covers__intro}</p>
        </div>
        <div class="skills-grid">
          <div class="skill-item">
            <h3>{pageText.what_the_group_covers__subheading}</h3>
            <p>{pageText.what_the_group_covers__text}</p>
          </div>
          <div class="skill-item">
            <h3>{pageText.what_the_group_covers__subheading_2}</h3>
            <p>{pageText.what_the_group_covers__text_2}</p>
          </div>
          <div class="skill-item">
            <h3>{pageText.what_the_group_covers__subheading_3}</h3>
            <p>{pageText.what_the_group_covers__text_3}</p>
          </div>
          <div class="skill-item">
            <h3>{pageText.what_the_group_covers__subheading_4}</h3>
            <p>{pageText.what_the_group_covers__text_4}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THE GROUP MAY HELP -->
  <section class="section" aria-labelledby="who-heading">
    <div class="container">
      <div class="dbt-narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{pageText.who_the_group_may_help__eyebrow}</p>
          <h2 id="who-heading">{pageText.who_the_group_may_help__heading}</h2>
        </div>
        <p>{pageText.who_the_group_may_help__text}</p>
        <ul class="offer-list">
{pageText.who_the_group_may_help__list.map((item) => <li>{item}</li>)}
</ul>
        <p class="closing-note">{pageText.who_the_group_may_help__text_2}</p>
      </div>
    </div>
  </section>

  <!-- WHAT TO EXPECT -->
  <section class="section section--tint" aria-labelledby="expect-heading">
    <div class="container">
      <div class="dbt-narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{pageText.what_to_expect__eyebrow}</p>
          <h2 id="expect-heading">{pageText.what_to_expect__heading}</h2>
        </div>
        <div class="expect-body">
          <p>{pageText.what_to_expect__text}</p>
          <p>{pageText.what_to_expect__text_2}</p>
          <p>{pageText.what_to_expect__text_3}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    subheading={pageText.cta__subheading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .dbt-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/dbt/dbt-hero-photo.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .dbt-hero {
      background-image: url('/images/dbt/dbt-hero-photo-1080.jpg');
    }
  }

  .dbt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .dbt-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .dbt-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .dbt-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  /* Skills grid (4-card, same pattern as gambling-counselling impact grid) */
  .skills-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .skill-item {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 24px;
    border: 1px solid var(--color-secondary);
  }

  .skill-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .skill-item p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Who it can help + What to expect narrow sections */
  .dbt-narrow {
    max-width: 720px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    margin-bottom: 20px;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .closing-note {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .expect-body p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .expect-body p:last-child {
    margin-bottom: 0;
  }

  /* Schedule table */
  .schedule-scroll {
    overflow-x: auto;
    max-width: 720px;
    margin-inline: auto;
  }

  .schedule-table-wrap {
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-secondary);
    min-width: 480px;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    background-color: var(--color-white);
  }

  .schedule-table thead {
    background-color: var(--color-primary);
  }

  .schedule-table thead th {
    padding: 14px 20px;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  .schedule-table tbody tr {
    border-bottom: 1px solid var(--color-secondary);
  }

  .schedule-table tbody tr:last-child {
    border-bottom: none;
  }

  .schedule-table tbody tr:nth-child(even) {
    background-color: var(--color-tint);
  }

  .schedule-table td {
    padding: 14px 20px;
    color: var(--color-text);
  }

  .schedule-table td:first-child {
    font-weight: 600;
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
