---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import programSchedules from '../../content/program-schedules.json';
import { formatRange, sortRows } from '../../lib/schedule';
import { pageContent, fieldSource } from '../../lib/pages';

// Words and images: src/content/pages/services--group-dbt-therapy.yaml (edited in /admin).
const ID = 'services--group-dbt-therapy';
const page = await pageContent(ID, 'group-dbt-therapy');
const { seo, hero, overview, skills, who, expect, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const schedule = sortRows(programSchedules.sections.dbt);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="dbt-hero" aria-label="Group DBT Therapy">
    <div class="dbt-hero__overlay" aria-hidden="true"></div>
    <div class="container dbt-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="dbt-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- INTRO + SERVICE DETAILS -->
  <section class="section" aria-labelledby="dbt-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{overview.heading.eyebrow}</p>
            <h2 id="dbt-overview-heading">{overview.heading.heading}</h2>
          </div>
          {overview.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`overview.paragraphs.${i}`)} /></p></>)}
        </div>
        <div>
          <InfoTable rows={overview.details.rows} caption={overview.details.caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- CURRENT GROUP DETAILS -->
  <section class="section" aria-labelledby="schedule-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{page.schedule.heading.eyebrow}</p>
        <h2 id="schedule-heading">{page.schedule.heading.heading}</h2>
        <p class="section-heading__lead"><Prose md={page.schedule.heading.lead} source={src('schedule.heading.lead')} /></p>
      </div>
      <div class="schedule-scroll">
        <div class="schedule-table-wrap">
          <table class="schedule-table" aria-label="DBT group schedule">
            <thead>
              <tr>
                <th scope="col">Day</th>
                <th scope="col">Time</th>
                <th scope="col">Notes</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map(row => (
                <tr>
                  <td>{row.day}</td>
                  <td>{formatRange(row.start, row.end)}</td>
                  <td>{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT THE GROUP COVERS -->
  <section class="section section--tint" aria-labelledby="skills-heading">
    <div class="container">
      <div class="skills-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{skills.heading.eyebrow}</p>
          <h2 id="skills-heading">{skills.heading.heading}</h2>
          <p class="section-heading__lead"><Prose md={skills.heading.lead} source={src('skills.heading.lead')} /></p>
        </div>
        <div class="skills-grid">
          {skills.items.map((item, i) => <>{i > 0 && ' '}<div class="skill-item">
            <h3>{item.heading}</h3>
            <p><Prose md={item.body} source={src(`skills.items.${i}.body`)} /></p>
          </div></>)}
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THE GROUP MAY HELP -->
  <section class="section" aria-labelledby="who-heading">
    <div class="container">
      <div class="dbt-narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{who.heading.eyebrow}</p>
          <h2 id="who-heading">{who.heading.heading}</h2>
        </div>
        <p><Prose md={who.intro} source={src('who.intro')} /></p>
        <ul class="offer-list">
          {who.items.map((item, i) => <>{i > 0 && ' '}<li><Prose md={item} source={src(`who.items.${i}`)} /></li></>)}
        </ul>
        <p class="closing-note"><Prose md={who.closing} source={src('who.closing')} /></p>
      </div>
    </div>
  </section>

  <!-- WHAT TO EXPECT -->
  <section class="section section--tint" aria-labelledby="expect-heading">
    <div class="container">
      <div class="dbt-narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{expect.heading.eyebrow}</p>
          <h2 id="expect-heading">{expect.heading.heading}</h2>
        </div>
        <div class="expect-body">
          {expect.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`expect.paragraphs.${i}`)} /></p></>)}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .dbt-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/dbt/dbt-hero-photo.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .dbt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .dbt-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .dbt-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .dbt-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  /* Skills grid (4-card, same pattern as gambling-counselling impact grid) */
  .skills-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .skill-item {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 24px;
    border: 1px solid var(--color-secondary);
  }

  .skill-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .skill-item p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Who it can help + What to expect narrow sections */
  .dbt-narrow {
    max-width: 720px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    margin-bottom: 20px;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .closing-note {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .expect-body p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .expect-body p:last-child {
    margin-bottom: 0;
  }

  /* Schedule table */
  .schedule-scroll {
    overflow-x: auto;
    max-width: 720px;
    margin-inline: auto;
  }

  .schedule-table-wrap {
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-secondary);
    min-width: 480px;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    background-color: var(--color-white);
  }

  .schedule-table thead {
    background-color: var(--color-primary);
  }

  .schedule-table thead th {
    padding: 14px 20px;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  .schedule-table tbody tr {
    border-bottom: 1px solid var(--color-secondary);
  }

  .schedule-table tbody tr:last-child {
    border-bottom: none;
  }

  .schedule-table tbody tr:nth-child(even) {
    background-color: var(--color-tint);
  }

  .schedule-table td {
    padding: 14px 20px;
    color: var(--color-text);
  }

  .schedule-table td:first-child {
    font-weight: 600;
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
