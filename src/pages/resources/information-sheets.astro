---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import { pageContent, fieldSource } from '../../lib/pages';

// Words: src/content/pages/resources--information-sheets.yaml (edited in /admin).
const ID = 'resources--information-sheets';
const page = await pageContent(ID, 'information-sheets');
const src = (path: string) => fieldSource(ID, path);
const { seo, hero, comingSoon, cta } = page;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
>

  <section class="simple-hero" aria-label={hero.breadcrumb}>
    <div class="container simple-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/resources/">Resources</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="simple-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <section class="section" aria-labelledby="info-heading">
    <div class="container">
      <div class="placeholder-content">
        <div class="placeholder-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <h2 id="info-heading">{comingSoon.heading}</h2>
        <p>{comingSoon.text}</p>
        <div class="btn-group">
          <a href={comingSoon.contact.href} class="btn btn--primary">{comingSoon.contact.label}</a>
          <a href={comingSoon.back.href} class="btn btn--secondary">{comingSoon.back.label}</a>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .simple-hero {
    background-color: var(--color-primary);
    padding-block: 64px 56px;
  }

  .simple-hero__content {
    max-width: 600px;
  }

  .simple-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 10px;
  }

  .simple-hero__lead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.85);
    margin-bottom: 0;
  }

  .placeholder-content {
    max-width: 560px;
    text-align: center;
    margin-inline: auto;
    padding: 48px 32px;
  }

  .placeholder-icon {
    color: var(--color-secondary);
    margin-bottom: 20px;
  }

  .placeholder-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 14px;
  }

  .placeholder-content p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 28px;
  }
</style>
