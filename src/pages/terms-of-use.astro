---
import pageText from '../content/pages/terms-of-use.json';
import { inlineMarkdown } from '../lib/format';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
>

  <!-- HERO -->
  <section class="legal-hero" aria-label="Terms of Use">
    <div class="container legal-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Terms of Use</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
    </div>
  </section>

  <!-- DOCUMENT BODY -->
  <section class="section" aria-label="Terms of Use content">
    <div class="container">
      <div class="doc-wrap">

        <!-- Dates -->
        <div class="doc-meta">
          <p set:html={inlineMarkdown(pageText.dates__text)}></p>
          <p set:html={inlineMarkdown(pageText.dates__text_2)}></p>
        </div>

        <!-- Table of contents -->
        <nav class="doc-toc" aria-label="Page contents">
          <p class="doc-toc__heading">{pageText.table_of_contents__text}</p>
          <ol class="doc-toc__list">
{pageText.table_of_contents__list.map((item) => <li set:html={inlineMarkdown(item)} />)}
</ol>
        </nav>

        <!-- Section 1 -->
        <div class="doc-section" id="section-1">
          <h2>{pageText.section_1__heading}</h2>
          <p>{pageText.section_1__text}</p>
          <p>{pageText.section_1__text_2}</p>
          <p>{pageText.section_1__text_3}</p>
        </div>

        <!-- Section 2 -->
        <div class="doc-section" id="section-2">
          <h2>{pageText.section_2__heading}</h2>
          <p>{pageText.section_2__text}</p>
          <p>{pageText.section_2__text_2}</p>
          <p>{pageText.section_2__text_3}</p>
        </div>

        <!-- Section 3 -->
        <div class="doc-section" id="section-3">
          <h2>{pageText.section_3__heading}</h2>
          <p>{pageText.section_3__text}</p>
          <ul>
{pageText.section_3__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.section_3__text_2}</p>
          <ul>
{pageText.section_3__list_2.map((item) => <li>{item}</li>)}
</ul>
        </div>

        <!-- Section 4 -->
        <div class="doc-section" id="section-4">
          <h2>{pageText.section_4__heading}</h2>
          <p>{pageText.section_4__text}</p>
          <ul>
{pageText.section_4__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.section_4__text_2}</p>
          <p>{pageText.section_4__text_3}</p>
        </div>

        <!-- Section 5 -->
        <div class="doc-section" id="section-5">
          <h2>{pageText.section_5__heading}</h2>
          <p>{pageText.section_5__text}</p>
          <p>{pageText.section_5__text_2}</p>
          <ul>
{pageText.section_5__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.section_5__text_3}</p>
          <ul>
{pageText.section_5__list_2.map((item) => <li>{item}</li>)}
</ul>
        </div>

        <!-- Section 6 -->
        <div class="doc-section" id="section-6">
          <h2>{pageText.section_6__heading}</h2>
          <p>{pageText.section_6__text}</p>
          <p>{pageText.section_6__text_2}</p>
        </div>

        <!-- Section 7 -->
        <div class="doc-section" id="section-7">
          <h2>{pageText.section_7__heading}</h2>
          <p>{pageText.section_7__text}</p>
          <ul>
{pageText.section_7__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.section_7__text_2}</p>
          <p>{pageText.section_7__text_3}</p>
        </div>

        <!-- Section 8 -->
        <div class="doc-section" id="section-8">
          <h2>{pageText.section_8__heading}</h2>
          <p>{pageText.section_8__text}</p>
          <p>{pageText.section_8__text_2}</p>
          <p set:html={inlineMarkdown(pageText.section_8__text_3)}></p>
        </div>

        <!-- Section 9 -->
        <div class="doc-section" id="section-9">
          <h2>{pageText.section_9__heading}</h2>
          <p>{pageText.section_9__text}</p>
          <ul>
{pageText.section_9__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.section_9__text_2}</p>
        </div>

        <!-- Section 10 -->
        <div class="doc-section" id="section-10">
          <h2>{pageText.section_10__heading}</h2>
          <p>{pageText.section_10__text}</p>
          <p>{pageText.section_10__text_2}</p>
        </div>

        <!-- Section 11 -->
        <div class="doc-section" id="section-11">
          <h2>{pageText.section_11__heading}</h2>
          <p>{pageText.section_11__text}</p>
        </div>

        <!-- Section 12 -->
        <div class="doc-section" id="section-12">
          <h2>{pageText.section_12__heading}</h2>
          <p>{pageText.section_12__text}</p>
          <p>{pageText.section_12__text_2}</p>
        </div>

        <!-- Section 13 -->
        <div class="doc-section" id="section-13">
          <h2>{pageText.section_13__heading}</h2>
          <p>{pageText.section_13__text}</p>
          <ul>
{pageText.section_13__list.map((item) => <li>{item}</li>)}
</ul>
        </div>

        <!-- Section 14 -->
        <div class="doc-section" id="section-14">
          <h2>{pageText.section_14__heading}</h2>
          <p>{pageText.section_14__text}</p>
        </div>

        <!-- Section 15 -->
        <div class="doc-section" id="section-15">
          <h2>{pageText.section_15__heading}</h2>
          <p>{pageText.section_15__text}</p>
          <p>{pageText.section_15__text_2}</p>
        </div>

        <!-- Section 16 -->
        <div class="doc-section" id="section-16">
          <h2>{pageText.section_16__heading}</h2>
          <p>{pageText.section_16__text}</p>
          <div class="doc-address doc-contact-card">
            <p set:html={inlineMarkdown(pageText.section_16__text_2)}></p>
            <p>{pageText.section_16__text_3}</p>
            <p set:html={inlineMarkdown(pageText.section_16__text_4)}></p>
            <p set:html={inlineMarkdown(pageText.section_16__text_5)}></p>
            <p set:html={inlineMarkdown(pageText.section_16__text_6)}></p>
          </div>
          <p>{pageText.section_16__text_7}</p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .legal-hero {
    background-color: var(--color-primary);
    padding-block: 52px 44px;
  }

  .legal-hero h1 {
    color: var(--color-white);
    margin-bottom: 0;
  }

  /* ---- Document wrapper ---- */
  .doc-wrap {
    max-width: 760px;
    margin-inline: auto;
  }

  /* ---- Dates metadata ---- */
  .doc-meta {
    padding: 18px 22px;
    background-color: var(--color-tint);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    margin-bottom: 36px;
  }

  .doc-meta p {
    margin-bottom: 4px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .doc-meta p:last-child {
    margin-bottom: 0;
  }

  /* ---- Table of contents ---- */
  .doc-toc {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 22px 28px;
    margin-bottom: 52px;
  }

  .doc-toc__heading {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 14px;
  }

  .doc-toc__list {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-left: 18px;
    margin-bottom: 0;
  }

  .doc-toc__list :global(a) {
    font-size: 0.9rem;
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .doc-toc__list :global(a:hover) {
    color: var(--color-link-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- Document sections ---- */
  .doc-section {
    margin-bottom: 48px;
  }

  .doc-section:last-child {
    margin-bottom: 0;
  }

  .doc-section h2 {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-secondary);
    scroll-margin-top: 88px;
  }

  .doc-section p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .doc-section p:last-child {
    margin-bottom: 0;
  }

  .doc-section ul {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .doc-section li {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 7px;
  }

  .doc-section :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .doc-section :global(a:hover) {
    color: var(--color-link-hover);
  }

  /* ---- Address / contact card ---- */
  .doc-address {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .doc-address p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .doc-address p:last-child {
    margin-bottom: 0;
  }

  .doc-address :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .doc-address :global(a:hover) {
    text-decoration: underline;
  }

  .doc-contact-card {
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    margin-top: 20px;
    margin-bottom: 20px;
  }
</style>
