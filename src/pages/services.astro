---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTABand from '../components/CTABand.astro';
import pageText from '../content/pages/services.json';
import { inlineMarkdown } from '../lib/format';

const categories = pageText.data__categories;

const services = pageText.data__services;

const steps = pageText.data__steps;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/centre/interior-img_2655-with-people.jpg"
>

  <!-- HERO -->
  <section class="services-hero" aria-label="Services">
    <div class="services-hero__overlay" aria-hidden="true"></div>
    <div class="container services-hero__content">
      <h1>{pageText.hero__title}</h1>
      <p class="services-hero__lead" set:html={inlineMarkdown(pageText.hero__intro)}></p>
      <div class="btn-group">
        <a href="/contact/" class="btn btn--white">{pageText.hero__button}</a><!-- TODO: Replace with live Jotform URL -->
      </div>
    </div>
  </section>

  <!-- WHAT WE OFFER -->
  <section class="section" aria-labelledby="categories-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.what_we_offer__eyebrow}</p>
        <h2 id="categories-heading">{pageText.what_we_offer__heading}</h2>
        <p class="section-heading__lead">{pageText.what_we_offer__intro}</p>
      </div>
      <div class="categories-grid">
        {categories.map(cat => (
          <div class="category-card">
            <div class="category-card__icon" aria-hidden="true">
              {cat.icon === 'heart' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              )}
              {cat.icon === 'people' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              )}
              {cat.icon === 'arrow' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 8 16 12 12 16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              )}
            </div>
            <h3 class="category-card__heading">{cat.heading}</h3>
            <p class="category-card__desc">{cat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ALL SERVICES GRID -->
  <section class="section section--tint" aria-labelledby="all-services-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.all_services_grid__eyebrow}</p>
        <h2 id="all-services-heading">{pageText.all_services_grid__heading}</h2>
      </div>
      <div class="card-grid">
        {services.map(s => (
          <ServiceCard
            title={s.title}
            summary={s.summary}
            href={s.href}
            image={s.image}
            imageAlt={s.imageAlt}
            eyebrow={s.eyebrow}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- HOW TO GET STARTED -->
  <section class="section" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.how_to_get_started__eyebrow}</p>
        <h2 id="steps-heading">{pageText.how_to_get_started__heading}</h2>
        <p class="section-heading__lead">{pageText.how_to_get_started__intro}</p>
      </div>
      <div class="steps-grid">
        {steps.map(step => (
          <div class="step-item">
            <div class="step-item__number" aria-hidden="true">{step.number}</div>
            <h3 class="step-item__heading">{step.heading}</h3>
            <p class="step-item__body">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO WE SUPPORT -->
  <section class="section section--tint" aria-labelledby="who-heading">
    <div class="container">
      <div class="who-split">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{pageText.who_we_support__eyebrow}</p>
          <h2 id="who-heading">{pageText.who_we_support__heading}</h2>
        </div>
        <div class="who-body">
          <p>{pageText.who_we_support__text}</p>
          <p>{pageText.who_we_support__text_2}</p>
          <a href="/contact/" class="btn btn--primary">{pageText.who_we_support__button}</a><!-- TODO: Replace with live Jotform URL -->
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  /* Hero */
  .services-hero {
    position: relative;
    min-height: 460px;
    background-image: url('/images/centre/interior-interior-1-with-people-img_2654.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .services-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.85) 100%);
  }

  .services-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 64px;
    max-width: 760px;
  }

  .services-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 16px;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .services-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 600px;
  }

  /* Category cards */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .category-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .category-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card);
  }

  .category-card__icon {
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .category-card__heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .category-card__desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Steps */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .step-item {
    position: relative;
  }

  .step-item__number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.6;
    line-height: 1;
    margin-bottom: 14px;
  }

  .step-item__heading {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .step-item__body {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Who we support */
  .who-split {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
    align-items: start;
  }

  .who-body p {
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .who-body .btn {
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .who-split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
