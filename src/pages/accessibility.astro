---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { pageContent, fieldSource } from '../lib/pages';

// Words: src/content/pages/accessibility.yaml (edited in /admin).
const ID = 'accessibility';
const page = await pageContent(ID, 'accessibility');
const { seo, hero, lastUpdated, intro, sections } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="legal-hero" aria-label="Accessibility">
    <div class="container legal-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
    </div>
  </section>

  <!-- DOCUMENT BODY -->
  <section class="section" aria-label="Accessibility statement content">
    <div class="container">
      <div class="doc-wrap">

        <!-- Date -->
        <div class="doc-meta">
          <p><em>{lastUpdated}</em></p>
        </div>

        <!-- Intro -->
        <div class="doc-section">
          <p><Prose md={intro} source={src('intro')} /></p>
        </div>

        {sections.map((s, si) => <>{' '}<div class="doc-section" id={s.id}>{' '}<h2>{s.heading}</h2>{s.blocks.map((b, bi) => <>{' '}{b.paragraph !== undefined ? <p><Prose md={b.paragraph} source={src(`sections.${si}.blocks.${bi}.paragraph`)} /></p> : b.items ? <ul>{b.items.map((it, ii) => <>{' '}<li><Prose md={it} source={src(`sections.${si}.blocks.${bi}.items.${ii}`)} /></li></>)}{' '}</ul> : b.callout ? <div class="doc-address">{' '}<p><strong>{b.callout.heading}</strong></p>{b.callout.lines.map((l, li) => <>{' '}<p><Prose md={l} source={src(`sections.${si}.blocks.${bi}.callout.lines.${li}`)} /></p></>)}{' '}</div> : <div class="doc-address doc-contact-card">{' '}<p><strong>{b.contactCard.heading}</strong></p>{b.contactCard.lines.map((l, li) => <>{' '}<p><Prose md={l} source={src(`sections.${si}.blocks.${bi}.contactCard.lines.${li}`)} /></p></>)}{' '}</div>}</>)}{' '}</div></>)}

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .legal-hero {
    background-color: var(--color-primary);
    padding-block: 52px 44px;
  }

  .legal-hero h1 {
    color: var(--color-white);
    margin-bottom: 0;
  }

  /* ---- Document wrapper ---- */
  .doc-wrap {
    max-width: 760px;
    margin-inline: auto;
  }

  /* ---- Date metadata ---- */
  .doc-meta {
    padding: 18px 22px;
    background-color: var(--color-tint);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    margin-bottom: 36px;
  }

  .doc-meta p {
    margin-bottom: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* ---- Document sections ---- */
  .doc-section {
    margin-bottom: 48px;
  }

  .doc-section:last-child {
    margin-bottom: 0;
  }

  .doc-section h2 {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-secondary);
    scroll-margin-top: 88px;
  }

  .doc-section p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .doc-section p:last-child {
    margin-bottom: 0;
  }

  .doc-section ul {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .doc-section li {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 7px;
  }

  .doc-section a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .doc-section a:hover {
    color: var(--color-link-hover);
  }
</style>
