---
import pageText from '../content/pages/accessibility.json';
import { inlineMarkdown } from '../lib/format';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
>

  <!-- HERO -->
  <section class="legal-hero" aria-label="Accessibility">
    <div class="container legal-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Accessibility</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
    </div>
  </section>

  <!-- DOCUMENT BODY -->
  <section class="section" aria-label="Accessibility statement content">
    <div class="container">
      <div class="doc-wrap">

        <!-- Date -->
        <div class="doc-meta">
          <p set:html={inlineMarkdown(pageText.date__text)}></p>
        </div>

        <!-- Intro -->
        <div class="doc-section">
          <p>{pageText.intro__text}</p>
        </div>

        <!-- Our commitment -->
        <div class="doc-section" id="our-commitment">
          <h2>{pageText.our_commitment__heading}</h2>
          <p>{pageText.our_commitment__text}</p>
        </div>

        <!-- What we've done -->
        <div class="doc-section" id="what-weve-done">
          <h2>{pageText.what_we_ve_done__heading}</h2>
          <p>{pageText.what_we_ve_done__text}</p>
          <ul>
{pageText.what_we_ve_done__list.map((item) => <li>{item}</li>)}
</ul>
        </div>

        <!-- Known limitations -->
        <div class="doc-section" id="known-limitations">
          <h2>{pageText.known_limitations__heading}</h2>
          <p>{pageText.known_limitations__text}</p>
          <ul>
{pageText.known_limitations__list.map((item) => <li set:html={inlineMarkdown(item)} />)}
</ul>
        </div>

        <!-- Accessibility at our centre -->
        <div class="doc-section" id="at-our-centre">
          <h2>{pageText.accessibility_at_our_centre__heading}</h2>
          <p>{pageText.accessibility_at_our_centre__text}</p>
          <ul>
{pageText.accessibility_at_our_centre__list.map((item) => <li set:html={inlineMarkdown(item)} />)}
</ul>
          <p set:html={inlineMarkdown(pageText.accessibility_at_our_centre__text_2)}></p>
        </div>

        <!-- Need our help? -->
        <div class="doc-section" id="need-our-help">
          <h2>{pageText.need_our_help__heading}</h2>
          <p>{pageText.need_our_help__text}</p>
          <p set:html={inlineMarkdown(pageText.need_our_help__text_2)}></p>
          <p set:html={inlineMarkdown(pageText.need_our_help__text_3)}></p>
          <p>{pageText.need_our_help__text_4}</p>
        </div>

        <!-- Reporting an issue -->
        <div class="doc-section" id="reporting-an-issue">
          <h2>{pageText.reporting_an_issue__heading}</h2>
          <p>{pageText.reporting_an_issue__text}</p>
          <ul>
{pageText.reporting_an_issue__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.reporting_an_issue__text_2}</p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .legal-hero {
    background-color: var(--color-primary);
    padding-block: 52px 44px;
  }

  .legal-hero h1 {
    color: var(--color-white);
    margin-bottom: 0;
  }

  /* ---- Document wrapper ---- */
  .doc-wrap {
    max-width: 760px;
    margin-inline: auto;
  }

  /* ---- Date metadata ---- */
  .doc-meta {
    padding: 18px 22px;
    background-color: var(--color-tint);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    margin-bottom: 36px;
  }

  .doc-meta p {
    margin-bottom: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* ---- Document sections ---- */
  .doc-section {
    margin-bottom: 48px;
  }

  .doc-section:last-child {
    margin-bottom: 0;
  }

  .doc-section h2 {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-secondary);
    scroll-margin-top: 88px;
  }

  .doc-section p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .doc-section p:last-child {
    margin-bottom: 0;
  }

  .doc-section ul {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .doc-section li {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 7px;
  }

  .doc-section :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .doc-section :global(a:hover) {
    color: var(--color-link-hover);
  }
</style>
