---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import Prose from '../components/Prose.astro';
import { pageContent, fieldSource } from '../lib/pages';

// Words and images: src/content/pages/support-us.yaml (edited in /admin).
const ID = 'support-us';
const page = await pageContent(ID, 'support-us');
const { seo, hero, intro, donate, otherWays: ways, assurance, cta } = page;
const donationFaqs = page.faq.items;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
  noindex={true}
>

  <!-- HERO -->
  <Hero
    heading={hero.heading}
    subheading={hero.subheading}
    image={hero.image.src}
    imageAlt={hero.image.alt}
    buttons={hero.buttons.map(b => ({ text: b.label, href: b.href, variant: b.style }))}
  />

  <!-- INTRO -->
  <section class="section" aria-labelledby="intro-heading">
    <div class="container intro-container">
      <h2 id="intro-heading" class="visually-hidden">{intro.srHeading}</h2>
      <p class="intro-text">{intro.text}</p>
    </div>
  </section>

  <!-- DONATE + OTHER WAYS TO GIVE -->
  <section class="section section--tint" aria-labelledby="donate-heading">
    <div class="container">
      <h2 id="donate-heading" class="visually-hidden">{donate.srHeading}</h2>
      <div class="donate-columns">

        <!-- LEFT: GiveNow embed -->
        <div class="donate-embed-card">
          <h2>{donate.heading}</h2>
          <script is:inline src="https://www.givenow.com.au/js/iframe-resizer/iframeResizer.min.js?version=4.3.2.1"></script>
          <div style="padding:1px"><iframe id="cause11851" class="gn-iframe" src="https://www.givenow.com.au/embed/Y2F1c2VpZD0xMTg1MSZkb21haW49b2FrZGVuZS1ob3VzZS13ZWJzaXRlLnBhZ2VzLmRldiZ0b2tlbj0xMTg1MTo0ZDViZTJiMjBiN2FkZTZh" style="width:1px;min-width:100%;border:0;height:882px;" data-offset-bonus="0"></iframe></div>
          <script is:inline>iFrameResize({checkOrigin:false,onScroll:function(){var element = document.getElementById("cause11851");var offsetBonus=element.getAttribute("data-offset-bonus");if(typeof offsetBonus !== typeof undefined){var offset=element.getBoundingClientRect().top-document.body.getBoundingClientRect().top;window.scrollTo({ top: offset-offsetBonus, behavior: 'smooth' });return false;}}}, "#cause11851")</script>
        </div>

        <!-- RIGHT: Other ways to give -->
        <aside class="donate-sidebar" aria-label={ways.ariaLabel}>
          <div class="donate-sidebar__inner">
            <h3 class="donate-sidebar__heading">{ways.heading}</h3>

            <div class="give-method">
              <h4>{ways.directDeposit.heading}</h4>
              <dl class="give-method__details">
                {ways.directDeposit.rows.map((r, i) => <>{i > 0 && ' '}<dt>{r.label}</dt> <dd>{r.value}</dd></>)}
              </dl>
            </div>

            <div class="give-method">
              <h4>{ways.cheque.heading}</h4>
              <p><Prose md={ways.cheque.text} source={src('otherWays.cheque.text')} /></p>
            </div>

            <div class="give-method">
              <h4>{ways.workplace.heading}</h4>
              <p><Prose md={ways.workplace.text} source={src('otherWays.workplace.text')} /></p>
            </div>

            <div class="give-method">
              <h4>{ways.will.heading}</h4>
              <p><Prose md={ways.will.text} source={src('otherWays.will.text')} /></p>
            </div>

            <div class="give-method give-method--last">
              <h4>{ways.corporate.heading}</h4>
              <p><Prose md={ways.corporate.text} source={src('otherWays.corporate.text')} /></p>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- ASSURANCE -->
  <section class="section" aria-labelledby="assurance-heading">
    <div class="container assurance-container">
      <h2 id="assurance-heading" class="visually-hidden">{assurance.srHeading}</h2>
      {assurance.lines.map((line, i) => <>{i > 0 && ' '}<p class="assurance-text"><em>{line}</em></p></>)}
      <p class="assurance-credentials">{assurance.credentials}</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--tint" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-heading">
        <h2 id="faq-heading">{page.faq.heading}</h2>
      </div>
      <FAQAccordion faqs={donationFaqs} />
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    dark={false}
  />

</BaseLayout>

<style>
  /* ── Intro ───────────────────────────────────────────── */
  .intro-container {
    max-width: 760px;
    text-align: center;
  }

  .intro-text {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  /* ── Two-column donate layout ────────────────────────── */
  .donate-columns {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Left: embed card — primary visual weight */
  .donate-embed-card {
    background: var(--color-white);
    border: 1px solid var(--color-secondary);
    border-left: 4px solid var(--color-primary);
    border-radius: 8px;
    padding: 48px;
    min-height: 500px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .donate-embed-card > h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 20px;
  }

  .placeholder-message {
    font-size: 1rem;
    font-style: italic;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .placeholder-detail {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 0;
  }

  /* Right: sidebar — secondary, no shadow, no accent */
  .donate-sidebar__inner {
    background: var(--color-white);
    border-radius: 8px;
    padding: 28px;
  }

  .donate-sidebar__heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-secondary);
  }

  .give-method {
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--color-tint);
  }

  .give-method--last {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .give-method h4 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .give-method p {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .give-method p a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition);
  }

  .give-method p a:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .give-method__details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 16px;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .give-method__details dt {
    font-weight: 600;
    color: var(--color-primary);
  }

  .give-method__details dd {
    color: var(--color-text);
    margin: 0;
  }

  /* ── Assurance ───────────────────────────────────────── */
  .assurance-container {
    max-width: 760px;
    text-align: center;
  }

  .assurance-text {
    font-size: 1.0625rem;
    color: var(--color-muted);
    line-height: 1.75;
    margin-bottom: 8px;
  }

  .assurance-credentials {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 20px;
    margin-bottom: 0;
    letter-spacing: 0.01em;
  }

  /* ── FAQ ─────────────────────────────────────────────── */
  .faq-container {
    max-width: 760px;
  }

  .faq-container .section-heading {
    margin-bottom: 32px;
  }

  .faq-container .section-heading h2 {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0;
  }

  /* ── Accessibility ───────────────────────────────────── */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 900px) {
    .donate-columns {
      grid-template-columns: 1fr;
    }

    .donate-embed-card {
      min-height: 320px;
    }
  }

  @media (max-width: 640px) {
    .donate-embed-card {
      padding: 28px 24px;
    }

    .donate-sidebar__inner {
      padding: 24px 20px;
    }
  }
</style>
