---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTABand from '../components/CTABand.astro';
import StatsGrid from '../components/StatsGrid.astro';
import pageText from '../content/pages/about.json';

// About page impact figures. The homepage uses a different, also confirmed, set.
const stats = pageText.data__stats;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/centre/exterior-exterior-1-img_2651.jpg"
>

  <!-- HERO -->
  <Hero
    heading={pageText.hero__heading}
    subheading={pageText.hero__subheading}
    image="/images/centre/exterior-exterior-1-img_2651.jpg"
    imageAlt={pageText.hero__image_alt}
    buttons={pageText.hero__buttons}
  />

  <!-- SUBPAGE NAVIGATION -->
  <section class="section subpage-nav-section" aria-label="About section pages">
    <div class="container">
      <div class="subpage-nav-grid">

        <a href="/about/the-oakdene-story/" class="subpage-nav-card">
          <div class="subpage-nav-card__image-wrap">
            <img src="/images/about/oakdene-tree-hero-colour.jpg" alt={pageText.subpage_navigation__image_alt} loading="lazy" />
          </div>
          <div class="subpage-nav-card__body">
            <h2>{pageText.subpage_navigation__heading}</h2>
            <p>{pageText.subpage_navigation__text}</p>
            <span class="subpage-nav-card__arrow" aria-hidden="true">{pageText.subpage_navigation__text_2}</span>
          </div>
        </a>

        <a href="/about/our-team/" class="subpage-nav-card">
          <div class="subpage-nav-card__image-wrap">
            <img src="/images/team/colour-mark-facing-camera.jpg" alt={pageText.subpage_navigation__image_alt_2} loading="lazy" style="object-position: center 30%;" />
          </div>
          <div class="subpage-nav-card__body">
            <h2>{pageText.subpage_navigation__heading_2}</h2>
            <p>{pageText.subpage_navigation__text_3}</p>
            <span class="subpage-nav-card__arrow" aria-hidden="true">{pageText.subpage_navigation__text_4}</span>
          </div>
        </a>

        <a href="/about/our-centre/" class="subpage-nav-card">
          <div class="subpage-nav-card__image-wrap">
            <img src="/images/centre/interior-interior-1-with-people-img_2654.jpg" alt={pageText.subpage_navigation__image_alt_3} loading="lazy" />
          </div>
          <div class="subpage-nav-card__body">
            <h2>{pageText.subpage_navigation__heading_3}</h2>
            <p>{pageText.subpage_navigation__text_5}</p>
            <span class="subpage-nav-card__arrow" aria-hidden="true">{pageText.subpage_navigation__text_6}</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="section" aria-labelledby="who-heading">
    <div class="container who-container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.who_we_are__eyebrow}</p>
        <h2 id="who-heading">{pageText.who_we_are__heading}</h2>
      </div>
      <p class="who-lead">{pageText.who_we_are__intro}</p>
    </div>
  </section>

  <!-- IMPACT -->
  <section class="section section--dark" aria-labelledby="impact-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.impact__eyebrow}</p>
        <h2 id="impact-heading">{pageText.impact__heading}</h2>
      </div>
      <StatsGrid stats={stats} />
    </div>
  </section>

  <!-- MISSION / VISION / VALUES -->
  <section class="section section--tint" aria-labelledby="mvv-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.mission_vision_values__eyebrow}</p>
        <h2 id="mvv-heading">{pageText.mission_vision_values__heading}</h2>
      </div>

      <div class="mvv-top">
        <div class="mvv-card mvv-card--dark">
          <p class="mvv-card__label">{pageText.mission_vision_values__text}</p>
          <p class="mvv-card__text">{pageText.mission_vision_values__text_2}</p>
        </div>
        <div class="mvv-card mvv-card--light">
          <p class="mvv-card__label">{pageText.mission_vision_values__text_3}</p>
          <p class="mvv-card__text">{pageText.mission_vision_values__text_4}</p>
        </div>
      </div>

      <h3 class="values-subheading">{pageText.mission_vision_values__subheading}</h3>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h4>{pageText.mission_vision_values__subheading_2}</h4>
          <p>{pageText.mission_vision_values__text_5}</p>
        </div>
        <div class="value-card">
          <div class="value-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <h4>{pageText.mission_vision_values__subheading_3}</h4>
          <p>{pageText.mission_vision_values__text_6}</p>
        </div>
        <div class="value-card">
          <div class="value-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h4>{pageText.mission_vision_values__subheading_4}</h4>
          <p>{pageText.mission_vision_values__text_7}</p>
        </div>
        <div class="value-card">
          <div class="value-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" stroke="none" fill="none"/><path d="M8 12s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/><circle cx="12" cy="12" r="10"/></svg>
          </div>
          <h4>{pageText.mission_vision_values__subheading_5}</h4>
          <p>{pageText.mission_vision_values__text_8}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR APPROACH -->
  <section class="section" aria-labelledby="approach-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.our_approach__eyebrow}</p>
            <h2 id="approach-heading">{pageText.our_approach__heading}</h2>
          </div>
          <p>{pageText.our_approach__text}</p>
          <p>{pageText.our_approach__text_2}</p>
        </div>
        <div class="split__image">
          <img
            src="/images/centre/interior-meetings-1-img_2657.jpg"
            alt={pageText.our_approach__image_alt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section section--tint" aria-labelledby="whatwedo-heading">
    <div class="container">
      <div class="split split--image-right">
        <div class="split__image">
          <img
            src="/images/centre/interior-interior-2-img_2656-with-people.jpg"
            alt={pageText.what_we_do__image_alt}
            loading="lazy"
          />
        </div>
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.what_we_do__eyebrow}</p>
            <h2 id="whatwedo-heading">{pageText.what_we_do__heading}</h2>
          </div>
          <ul class="what-list">
{pageText.what_we_do__list.map((item) => <li>{item}</li>)}
</ul>
          <div class="btn-group" style="margin-top: 28px;">
            <a href="/services/" class="btn btn--primary">{pageText.what_we_do__button}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  /* Subpage nav */
  .subpage-nav-section {
    padding-block: 56px;
    background-color: var(--color-tint);
  }

  .subpage-nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .subpage-nav-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .subpage-nav-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  .subpage-nav-card__image-wrap {
    height: 160px;
    overflow: hidden;
    background-color: var(--color-tint);
  }

  .subpage-nav-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .subpage-nav-card:hover .subpage-nav-card__image-wrap img {
    transform: scale(1.04);
  }

  .subpage-nav-card__image-wrap--icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.35;
  }

  .subpage-nav-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .subpage-nav-card__body h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .subpage-nav-card__body p {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 12px;
  }

  .subpage-nav-card__arrow {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition);
  }

  /* Who We Are */
  .who-container {
    max-width: 760px;
  }

  .who-lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    text-align: center;
    margin-bottom: 0;
  }

  /* Mission / Vision */
  .mvv-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 48px;
  }

  .mvv-card {
    padding: 32px;
    border-radius: var(--radius-card);
  }

  .mvv-card--dark {
    background-color: var(--color-primary);
  }

  .mvv-card--light {
    background-color: var(--color-white);
    border: 1px solid var(--color-secondary);
    box-shadow: var(--shadow-card);
  }

  .mvv-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .mvv-card--dark .mvv-card__label { color: var(--color-secondary); }
  .mvv-card--light .mvv-card__label { color: var(--color-primary); opacity: 0.85; }

  .mvv-card__text {
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 0;
  }

  .mvv-card--dark .mvv-card__text { color: rgba(255,255,255,0.9); }
  .mvv-card--light .mvv-card__text { color: var(--color-text); }

  /* Values */
  .values-subheading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8125rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .value-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    box-shadow: var(--shadow-card);
  }

  .value-card__icon {
    color: var(--color-primary);
    margin-bottom: 14px;
  }

  .value-card h4 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .value-card p {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin-bottom: 0;
  }

  /* What We Do */
  .what-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .what-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .what-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .subpage-nav-grid { grid-template-columns: repeat(2, 1fr); }
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .subpage-nav-grid { grid-template-columns: 1fr; }
    .mvv-top { grid-template-columns: 1fr; }
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
