---
import programs from '../../content/programs.json';
import { inline } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import pageText from '../../content/pages/community-programs-used-clothing-store.json';

const serviceRows = programs.used_clothing_store.rows.map((row) => ({ label: row.label, value: inline(row.value) }));

const guidelines = pageText.data__guidelines;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/boutique/boutique-interior-clothing-rack.jpg"
>

  <!-- HERO -->
  <section class="clothing-hero" aria-label="Used Clothing Store">
    <div class="clothing-hero__overlay" aria-hidden="true"></div>
    <div class="container clothing-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Used Clothing Store</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="clothing-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- INTRO + DETAILS -->
  <section class="section" aria-labelledby="clothing-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.intro_details__eyebrow}</p>
            <h2 id="clothing-intro-heading">{pageText.intro_details__heading}</h2>
          </div>
          <p>{pageText.intro_details__text}</p>
          <p>{pageText.intro_details__text_2}</p>

          <div class="guidelines-card">
            <h3>{pageText.intro_details__subheading}</h3>
            <ul class="guidelines-list">
              {guidelines.map(g => <li>{g}</li>)}
            </ul>
          </div>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={pageText.intro_details__caption} />
          <div class="eligibility-box">
            <h3>{pageText.intro_details__subheading_2}</h3>
            <p>{pageText.intro_details__text_3}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOTHING IMAGES -->
  <section class="clothing-images" aria-label="Clothing store photos">
    <div class="image-pair">
      <div class="image-pair__item">
        <img src="/images/boutique/boutique-interior-looking-down-shop-with-people.jpg" alt={pageText.clothing_images__image_alt} loading="lazy" />
      </div>
      <div class="image-pair__item">
        <img src="/images/boutique/boutique-interior-close-up-bag-warmer.jpg" alt={pageText.clothing_images__image_alt_2} loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ALSO AVAILABLE NOTE -->
  <section class="section" aria-label="Related services">
    <div class="container">
      <div class="also-available">
        <div class="also-available__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <p class="also-available__heading">{pageText.also_available_note__text}</p>
          <p>{pageText.also_available_note__text_2}</p>
          <div class="btn-group">
            <a href="/community-programs/oakdene-laundrette/" class="btn btn--secondary">{pageText.also_available_note__button}</a>
            <a href="/community-programs/oakdene-kitchen/" class="btn btn--secondary">{pageText.also_available_note__button_2}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .clothing-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/boutique/boutique-interior-clothing-rack.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .clothing-hero {
      background-image: url('/images/boutique/boutique-interior-clothing-rack-1080.jpg');
    }
  }

  .clothing-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .clothing-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .clothing-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .clothing-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .guidelines-card {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 24px 28px;
    margin-top: 28px;
  }

  .guidelines-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 14px;
  }

  .guidelines-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .guidelines-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .guidelines-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .eligibility-box {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
    margin-top: 20px;
  }

  .eligibility-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .eligibility-box p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Images */
  .clothing-images {
    background-color: var(--color-tint);
  }

  .image-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .image-pair__item {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .image-pair__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-pair__item:hover img {
    transform: scale(1.04);
  }

  /* Also available */
  .also-available {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 28px 32px;
    max-width: 680px;
  }

  .also-available__icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .also-available__heading {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-primary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .also-available p:last-of-type {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 16px;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .image-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
