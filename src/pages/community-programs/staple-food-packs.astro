---
import programs from '../../content/programs.json';
import { inline } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import pageText from '../../content/pages/community-programs-staple-food-packs.json';
import { inlineMarkdown } from '../../lib/format';

const serviceRows = programs.staple_food_packs.rows.map((row) => ({ label: row.label, value: inline(row.value) }));

const included = pageText.data__included;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/kitchen/oakdene-kitchen-interior-with-food-stacks.jpg"
>

  <!-- HERO -->
  <section class="packs-hero" aria-label="Staple Food Packs">
    <div class="packs-hero__overlay" aria-hidden="true"></div>
    <div class="container packs-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Staple Food Packs</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="packs-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- INTRO + DETAILS -->
  <section class="section" aria-labelledby="packs-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.intro_details__eyebrow}</p>
            <h2 id="packs-intro-heading">{pageText.intro_details__heading}</h2>
          </div>
          <p>{pageText.intro_details__text}</p>
          <p>{pageText.intro_details__text_2}</p>

          <h3 class="section-subhead">{pageText.intro_details__subheading}</h3>
          <ul class="offer-list">
            {included.map(item => <li>{item}</li>)}
          </ul>
          <div class="ozharvest-credit">
            <p>{pageText.intro_details__text_3}</p>
            <img src="/images/logos/partners/ozharvest-logo-yellow.jpeg" alt={pageText.intro_details__image_alt} class="ozharvest-credit__logo" />
          </div>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={pageText.intro_details__caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- FOOD IMAGE -->
  <div class="food-image-banner">
    <img src="/images/kitchen/kitchen-3x-staff-serving.jpg" alt={pageText.food_image__image_alt} loading="lazy" />
  </div>

  <!-- RULES + ELIGIBILITY -->
  <section class="section" aria-labelledby="rules-heading">
    <div class="container">
      <div class="narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{pageText.rules_eligibility__eyebrow}</p>
          <h2 id="rules-heading">{pageText.rules_eligibility__heading}</h2>
        </div>

        <div class="rules-grid">
          <div class="rules-card">
            <h3>{pageText.rules_eligibility__subheading}</h3>
            <ul class="rules-list">
{pageText.rules_eligibility__list.map((item) => <li>{item}</li>)}
</ul>
          </div>
          <div class="rules-card">
            <h3>{pageText.rules_eligibility__subheading_2}</h3>
            <p>{pageText.rules_eligibility__text}</p>
            <ul class="rules-list">
{pageText.rules_eligibility__list_2.map((item) => <li>{item}</li>)}
</ul>
          </div>
        </div>

        <div class="also-note">
          <p set:html={inlineMarkdown(pageText.rules_eligibility__text_2)}></p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .packs-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/kitchen/staple-food-packs-header.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .packs-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .packs-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .packs-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .packs-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .section-subhead {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 28px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  /* Image banner */
  .food-image-banner {
    width: 100%;
    height: 320px;
    overflow: hidden;
  }

  .food-image-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Rules */
  .narrow {
    max-width: 760px;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 28px;
  }

  .rules-card {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 24px;
  }

  .rules-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .rules-card p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin-bottom: 10px;
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .rules-list li {
    padding-left: 20px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .rules-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 600;
  }

  .also-note {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border-left: 3px solid var(--color-primary);
    padding: 16px 20px;
  }

  .also-note p {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0;
    line-height: 1.6;
  }

  .also-note :global(a) {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* OzHarvest inline credit */
  .ozharvest-credit {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ozharvest-credit p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    font-weight: 500;
  }

  .ozharvest-credit__logo {
    height: 70px;
    width: auto;
    display: block;
  }

  @media (max-width: 600px) {
    .rules-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
