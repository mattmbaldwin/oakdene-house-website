---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import hours from '../../content/opening-hours.json';
import { pageContent, fieldSource } from '../../lib/pages';
import { detailRows, fillHours } from '../../lib/service-details';

// Words and images: src/content/pages/community-programs--staple-food-packs.yaml (edited in /admin).
// The day and hours come from src/content/opening-hours.json.
const ID = 'community-programs--staple-food-packs';
const page = await pageContent(ID, 'staple-food-packs');
const { seo, hero, intro, banner, rules, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const serviceRows = detailRows(ID, intro.details, [
  ['day', hours.staplePacks.day],
  ['hours', hours.staplePacks.hours],
]);
---

<BaseLayout
  title={seo.title}
  description={fillHours(seo.description, hours.staplePacks.seoDay)}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="packs-hero" aria-label="Staple Food Packs">
    <div class="packs-hero__overlay" aria-hidden="true"></div>
    <div class="container packs-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="packs-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- INTRO + DETAILS -->
  <section class="section" aria-labelledby="packs-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{intro.heading.eyebrow}</p>
            <h2 id="packs-intro-heading">{intro.heading.heading}</h2>
          </div>
          <p><Prose md={intro.paragraph} source={src('intro.paragraph')} /></p>
          <p><Prose md={fillHours(intro.distribution, hours.staplePacks.distributionDay)} source={src('intro.distribution')} /></p>

          <h3 class="section-subhead">{intro.includedHeading}</h3>
          <ul class="offer-list">
            {intro.includedItems.map((item, i) => <li><Prose md={item} source={src(`intro.includedItems.${i}`)} /></li>)}
          </ul>
          <div class="ozharvest-credit">
            <p>{intro.creditLabel}</p>
            <img src={intro.creditLogo.src} alt={intro.creditLogo.alt} class="ozharvest-credit__logo" />
          </div>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={intro.details.caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- FOOD IMAGE -->
  <div class="food-image-banner">
    <img src={banner.src} alt={banner.alt} loading="lazy" />
  </div>

  <!-- RULES + ELIGIBILITY -->
  <section class="section" aria-labelledby="rules-heading">
    <div class="container">
      <div class="narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{rules.heading.eyebrow}</p>
          <h2 id="rules-heading">{rules.heading.heading}</h2>
        </div>

        <div class="rules-grid">
          <div class="rules-card">
            <h3>{rules.packRules.heading}</h3>
            <ul class="rules-list">
              {rules.packRules.items.map((item, i) => <>{i > 0 && ' '}<li><Prose md={item} source={src(`rules.packRules.items.${i}`)} /></li></>)}
            </ul>
          </div>
          <div class="rules-card">
            <h3>{rules.eligibility.heading}</h3>
            <p><Prose md={rules.eligibility.intro} source={src('rules.eligibility.intro')} /></p>
            <ul class="rules-list">
              {rules.eligibility.items.map((item, i) => <>{i > 0 && ' '}<li><Prose md={item} source={src(`rules.eligibility.items.${i}`)} /></li></>)}
            </ul>
          </div>
        </div>

        <div class="also-note">
          <p><Prose md={fillHours(rules.also, hours.staplePacks.alsoRunningDay)} source={src('rules.also')} /></p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .packs-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/kitchen/staple-food-packs-header.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .packs-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .packs-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .packs-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .packs-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .section-subhead {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 28px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  /* Image banner */
  .food-image-banner {
    width: 100%;
    height: 320px;
    overflow: hidden;
  }

  .food-image-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Rules */
  .narrow {
    max-width: 760px;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 28px;
  }

  .rules-card {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 24px;
  }

  .rules-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .rules-card p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin-bottom: 10px;
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .rules-list li {
    padding-left: 20px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .rules-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 600;
  }

  .also-note {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border-left: 3px solid var(--color-primary);
    padding: 16px 20px;
  }

  .also-note p {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0;
    line-height: 1.6;
  }

  .also-note a {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* OzHarvest inline credit */
  .ozharvest-credit {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ozharvest-credit p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    font-weight: 500;
  }

  .ozharvest-credit__logo {
    height: 70px;
    width: auto;
    display: block;
  }

  @media (max-width: 600px) {
    .rules-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
