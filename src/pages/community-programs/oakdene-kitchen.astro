---
import programs from '../../content/programs.json';
import { inline } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import pageText from '../../content/pages/community-programs-oakdene-kitchen.json';

const serviceRows = programs.oakdene_kitchen.rows.map((row) => ({ label: row.label, value: inline(row.value) }));

const whatWeOffer = pageText.data__what_we_offer;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/kitchen/oakdene-kitchen-exterior-line-up.jpg"
>

  <!-- HERO -->
  <section class="kitchen-hero" aria-label="Oakdene Kitchen">
    <div class="kitchen-hero__overlay" aria-hidden="true"></div>
    <div class="container kitchen-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Oakdene Kitchen</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="kitchen-hero__lead">{pageText.hero__intro}</p>
      <div class="btn-group">
        <a href="/contact/" class="btn btn--white">{pageText.hero__button}</a><!-- TODO: Replace with live Jotform URL -->
        <a href="/community-programs/volunteering/" class="btn btn--white-outline">{pageText.hero__button_2}</a>
      </div>
    </div>
  </section>

  <!-- INTRO + SERVICE DETAILS -->
  <section class="section" aria-labelledby="kitchen-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.intro_service_details__eyebrow}</p>
            <h2 id="kitchen-intro-heading">{pageText.intro_service_details__heading}</h2>
          </div>
          <p>{pageText.intro_service_details__text}</p>
          <p class="who-label">{pageText.intro_service_details__text_2}</p>
          <p>{pageText.intro_service_details__text_3}</p>

          <h3 class="offer-heading">{pageText.intro_service_details__subheading}</h3>
          <ul class="offer-list">
            {whatWeOffer.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={pageText.intro_service_details__caption} />
          <div class="motto-box">
            <p>{pageText.intro_service_details__text_4}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMAGE STRIP -->
  <section class="kitchen-images" aria-label="Oakdene Kitchen photos">
    <div class="container">
      <div class="image-strip">
        <div class="image-strip__item">
          <img src="/images/kitchen/kitchen-3x-staff-serving.jpg" alt={pageText.image_strip__image_alt} loading="lazy" />
        </div>
        <div class="image-strip__item">
          <img src="/images/kitchen/oakdene-kitchen-community-table.jpg" alt={pageText.image_strip__image_alt_2} loading="lazy" />
        </div>
        <div class="image-strip__item">
          <img src="/images/kitchen/oakdene-kitchen-interior-volunteer-serving.jpg" alt={pageText.image_strip__image_alt_3} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{pageText.how_it_works__eyebrow}</p>
          <h2 id="how-heading">{pageText.how_it_works__heading}</h2>
        </div>
        <p>{pageText.how_it_works__text}</p>

        <!-- ELIGIBILITY -->
        <div class="eligibility-box">
          <h3>{pageText.eligibility__subheading}</h3>
          <ul class="offer-list">
{pageText.eligibility__list.map((item) => <li>{item}</li>)}
</ul>
        </div>

        <!-- IMPORTANT NOTE -->
        <div class="callout-box callout-box--warning">
          <div class="callout-box__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div>
            <p class="callout-box__heading">{pageText.important_note__text}</p>
            <p>{pageText.important_note__text_2}</p>
          </div>
        </div>

        <!-- COMMUNITY GUIDELINES -->
        <div class="guidelines-box">
          <h3>{pageText.community_guidelines__subheading}</h3>
          <p>{pageText.community_guidelines__text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VOLUNTEER CALLOUT -->
  <section class="section section--tint volunteer-section" aria-labelledby="volunteer-heading">
    <div class="container">
      <div class="volunteer-split">
        <div class="volunteer-image">
          <img src="/images/volunteers/oakdene-volunteer-kitchen-2.jpg" alt={pageText.volunteer_callout__image_alt} loading="lazy" />
        </div>
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.volunteer_callout__eyebrow}</p>
            <h2 id="volunteer-heading">{pageText.volunteer_callout__heading}</h2>
          </div>
          <p>{pageText.volunteer_callout__text}</p>
          <p>{pageText.volunteer_callout__text_2}</p>
          <div class="btn-group">
            <a href="/community-programs/volunteering/" class="btn btn--primary">{pageText.volunteer_callout__button}</a>
            <a href="/contact/" class="btn btn--secondary">{pageText.volunteer_callout__button_2}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={{ text: 'Volunteer', href: '/community-programs/volunteering/' }}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .kitchen-hero {
    position: relative;
    min-height: 420px;
    background-image: url('/images/kitchen/oakdene-kitchen-exterior-line-up-final.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .kitchen-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.85) 100%);
  }

  .kitchen-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .kitchen-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .kitchen-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 28px;
    max-width: 520px;
  }

  .who-label {
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 24px;
    margin-bottom: 4px;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .offer-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .motto-box {
    margin-top: 20px;
    padding: 18px 24px;
    background-color: var(--color-primary);
    border-radius: var(--radius-card);
    color: var(--color-white);
    font-size: 1.0625rem;
    font-weight: 600;
    font-style: italic;
  }

  .motto-box p { margin-bottom: 0; }

  /* Image strip */
  .kitchen-images {
    padding-block: 8px 0;
    background-color: var(--color-tint);
  }

  .image-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .image-strip__item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .image-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-strip__item:hover img {
    transform: scale(1.04);
  }

  /* How it works */
  .narrow {
    max-width: 720px;
  }

  .eligibility-box {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
    margin: 28px 0;
  }

  .eligibility-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .eligibility-box p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .callout-box {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    border-radius: var(--radius-card);
    padding: 20px 24px;
    margin: 20px 0;
  }

  .callout-box--warning {
    background-color: #fff8e1;
    border: 1px solid #f0c040;
    border-left: 4px solid #e6a800;
  }

  .callout-box--warning .callout-box__icon {
    color: #c88000;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .callout-box__heading {
    font-weight: 700;
    color: var(--color-text);
    font-size: 0.9375rem;
    margin-bottom: 4px;
  }

  .callout-box p:last-child {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0;
    line-height: 1.6;
  }

  .guidelines-box {
    border-top: 1px solid var(--color-secondary);
    padding-top: 24px;
    margin-top: 8px;
  }

  .guidelines-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .guidelines-box p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Volunteer section */
  .volunteer-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    align-items: center;
  }

  .volunteer-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .volunteer-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .volunteer-split {
      grid-template-columns: 1fr;
    }
    .image-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
