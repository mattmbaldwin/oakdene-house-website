---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import hours from '../../content/opening-hours.json';
import { pageContent, fieldSource } from '../../lib/pages';
import { detailRows, fillHours } from '../../lib/service-details';

// Words and images: src/content/pages/community-programs--oakdene-kitchen.yaml (edited in /admin).
// The days and hours come from src/content/opening-hours.json.
const ID = 'community-programs--oakdene-kitchen';
const page = await pageContent(ID, 'oakdene-kitchen');
const { seo, hero, intro, photos, how, volunteer, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const serviceRows = detailRows(ID, intro.details, [
  ['days', hours.kitchen.days],
  ['hours', hours.kitchen.hours],
]);
---

<BaseLayout
  title={seo.title}
  description={fillHours(seo.description, hours.kitchen.seoDays)}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="kitchen-hero" aria-label="Oakdene Kitchen">
    <div class="kitchen-hero__overlay" aria-hidden="true"></div>
    <div class="container kitchen-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="kitchen-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
      <div class="btn-group">
        <a href={hero.primary.href} class="btn btn--white">{hero.primary.label}</a><!-- TODO: Replace with live Jotform URL -->
        <a href={hero.secondary.href} class="btn btn--white-outline">{hero.secondary.label}</a>
      </div>
    </div>
  </section>

  <!-- INTRO + SERVICE DETAILS -->
  <section class="section" aria-labelledby="kitchen-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{intro.heading.eyebrow}</p>
            <h2 id="kitchen-intro-heading">{intro.heading.heading}</h2>
          </div>
          <p><Prose md={intro.paragraph} source={src('intro.paragraph')} /></p>
          <p class="who-label">{intro.whoLabel}</p>
          <p><Prose md={intro.whoText} source={src('intro.whoText')} /></p>

          <h3 class="offer-heading">{intro.offerHeading}</h3>
          <ul class="offer-list">
            {intro.offerItems.map((item, i) => <li><Prose md={item} source={src(`intro.offerItems.${i}`)} /></li>)}
          </ul>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={intro.details.caption} />
          <div class="motto-box">
            <p>{intro.motto}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMAGE STRIP -->
  <section class="kitchen-images" aria-label="Oakdene Kitchen photos">
    <div class="container">
      <div class="image-strip">
        <div class="image-strip__item">
          <img src={photos[0].src} alt={photos[0].alt} loading="lazy" />
        </div>
        <div class="image-strip__item">
          <img src={photos[1].src} alt={photos[1].alt} loading="lazy" />
        </div>
        <div class="image-strip__item">
          <img src={photos[2].src} alt={photos[2].alt} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{how.heading.eyebrow}</p>
          <h2 id="how-heading">{how.heading.heading}</h2>
        </div>
        <p><Prose md={how.intro} source={src('how.intro')} /></p>

        <!-- ELIGIBILITY -->
        <div class="eligibility-box">
          <h3>{how.eligibility.heading}</h3>
          <ul class="offer-list">
            {how.eligibility.items.map((item, i) => <>{i > 0 && ' '}<li><Prose md={item} source={src(`how.eligibility.items.${i}`)} /></li></>)}
          </ul>
        </div>

        <!-- IMPORTANT NOTE -->
        <div class="callout-box callout-box--warning">
          <div class="callout-box__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div>
            <p class="callout-box__heading">{how.note.heading}</p>
            <p><Prose md={how.note.text} source={src('how.note.text')} /></p>
          </div>
        </div>

        <!-- COMMUNITY GUIDELINES -->
        <div class="guidelines-box">
          <h3>{how.guidelines.heading}</h3>
          <p><Prose md={how.guidelines.text} source={src('how.guidelines.text')} /></p>
        </div>
      </div>
    </div>
  </section>

  <!-- VOLUNTEER CALLOUT -->
  <section class="section section--tint volunteer-section" aria-labelledby="volunteer-heading">
    <div class="container">
      <div class="volunteer-split">
        <div class="volunteer-image">
          <img src={volunteer.image.src} alt={volunteer.image.alt} loading="lazy" />
        </div>
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{volunteer.heading.eyebrow}</p>
            <h2 id="volunteer-heading">{volunteer.heading.heading}</h2>
          </div>
          {volunteer.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`volunteer.paragraphs.${i}`)} /></p></>)}
          <div class="btn-group">
            <a href={volunteer.primary.href} class="btn btn--primary">{volunteer.primary.label}</a>
            <a href={volunteer.secondary.href} class="btn btn--secondary">{volunteer.secondary.label}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .kitchen-hero {
    position: relative;
    min-height: 420px;
    background-image: url('/images/kitchen/oakdene-kitchen-exterior-line-up-final.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .kitchen-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.85) 100%);
  }

  .kitchen-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .kitchen-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .kitchen-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 28px;
    max-width: 520px;
  }

  .who-label {
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 24px;
    margin-bottom: 4px;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .offer-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .motto-box {
    margin-top: 20px;
    padding: 18px 24px;
    background-color: var(--color-primary);
    border-radius: var(--radius-card);
    color: var(--color-white);
    font-size: 1.0625rem;
    font-weight: 600;
    font-style: italic;
  }

  .motto-box p { margin-bottom: 0; }

  /* Image strip */
  .kitchen-images {
    padding-block: 8px 0;
    background-color: var(--color-tint);
  }

  .image-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .image-strip__item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .image-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-strip__item:hover img {
    transform: scale(1.04);
  }

  /* How it works */
  .narrow {
    max-width: 720px;
  }

  .eligibility-box {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
    margin: 28px 0;
  }

  .eligibility-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .eligibility-box p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .callout-box {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    border-radius: var(--radius-card);
    padding: 20px 24px;
    margin: 20px 0;
  }

  .callout-box--warning {
    background-color: #fff8e1;
    border: 1px solid #f0c040;
    border-left: 4px solid #e6a800;
  }

  .callout-box--warning .callout-box__icon {
    color: #c88000;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .callout-box__heading {
    font-weight: 700;
    color: var(--color-text);
    font-size: 0.9375rem;
    margin-bottom: 4px;
  }

  .callout-box p:last-child {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0;
    line-height: 1.6;
  }

  .guidelines-box {
    border-top: 1px solid var(--color-secondary);
    padding-top: 24px;
    margin-top: 8px;
  }

  .guidelines-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .guidelines-box p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Volunteer section */
  .volunteer-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    align-items: center;
  }

  .volunteer-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .volunteer-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .volunteer-split {
      grid-template-columns: 1fr;
    }
    .image-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
