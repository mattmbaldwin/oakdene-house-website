---
import pageText from '../../../content/pages/community-programs-volunteering-thank-you.json';
import { inlineMarkdown } from '../../../lib/format';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/kitchen/oakdene-kitchen-volunteer-serving-with-smile.jpg"
>

  <!-- HERO -->
  <section class="ty-hero" aria-label="Volunteer application received">
    <div class="ty-hero__overlay" aria-hidden="true"></div>
    <div class="container ty-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/volunteering/">Volunteering</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Thank You</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="section" aria-label="What happens next">
    <div class="container">
      <div class="ty-body">
        <p set:html={inlineMarkdown(pageText.content__text)}></p>
        <div class="ty-actions">
          <a href="/" class="btn btn--primary">{pageText.content__button}</a>
          <a href="/services/" class="btn btn--secondary">{pageText.content__button_2}</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .ty-hero {
    position: relative;
    min-height: 320px;
    background-image: url('/images/kitchen/oakdene-kitchen-volunteer-serving-with-smile.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .ty-hero {
      background-image: url('/images/kitchen/oakdene-kitchen-volunteer-serving-with-smile-1080.jpg');
    }
  }

  .ty-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.88) 100%);
  }

  .ty-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
    max-width: 740px;
  }

  .ty-hero__content h1 {
    color: var(--color-white);
    margin-top: 16px;
    margin-bottom: 0;
  }

  .ty-body {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    padding-block: 20px;
  }

  .ty-body p {
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .ty-body :global(a) {
    color: var(--color-primary);
    font-weight: 500;
  }

  .ty-body :global(a:hover) {
    color: var(--color-primary-hover);
  }

  .ty-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .ty-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
