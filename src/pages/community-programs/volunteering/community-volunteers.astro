---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTABand from '../../../components/CTABand.astro';
import pageText from '../../../content/pages/community-programs-volunteering-community-volunteers.json';

const roles = pageText.data__roles;

const lookFor = pageText.data__look_for;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/volunteers/oakdene-volunteer-kitchen-1a.jpg"
>

  <!-- HERO -->
  <section class="cv-hero" aria-label="Community Volunteers">
    <div class="cv-hero__overlay" aria-hidden="true"></div>
    <div class="container cv-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/volunteering/">Volunteering</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Community Volunteers</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="cv-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="cv-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.overview__eyebrow}</p>
            <h2 id="cv-overview-heading">{pageText.overview__heading}</h2>
          </div>
          <p>{pageText.overview__text}</p>
          <p>{pageText.overview__text_2}</p>

          <h3 class="roles-heading">{pageText.overview__subheading}</h3>
          <ul class="item-list">
            {roles.map(r => <li>{r}</li>)}
          </ul>
        </div>
        <div>
          <div class="cv-image">
            <img src="/images/kitchen/oakdene-kitchen-volunteer-serving-with-smile.jpg" alt={pageText.overview__image_alt} loading="lazy" />
          </div>
          <div class="cv-image cv-image--second">
            <img src="/images/kitchen/oakdene-kitchen-volunteers-wrappimg-bread.jpg" alt={pageText.overview__image_alt_2} loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE LOOK FOR -->
  <section class="section section--tint" aria-labelledby="lookfor-heading">
    <div class="container">
      <div class="lookfor-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{pageText.what_we_look_for__eyebrow}</p>
          <h2 id="lookfor-heading">{pageText.what_we_look_for__heading}</h2>
        </div>
        <div class="lookfor-items">
          {lookFor.map(item => (
            <div class="lookfor-item">
              <div class="lookfor-item__check" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <p>{item}</p>
            </div>
          ))}
        </div>

        <div class="apply-note">
          <p>{pageText.what_we_look_for__text}</p>
          <a href="/community-programs/volunteering/" class="btn btn--primary">{pageText.what_we_look_for__button}</a><!-- TODO: Replace with live Jotform URL -->
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    subheading={pageText.cta__subheading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  .cv-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/volunteers/oakdene-volunteer-kitchen-1a.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .cv-hero {
      background-image: url('/images/volunteers/oakdene-volunteer-kitchen-1a-1080.jpg');
    }
  }

  .cv-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.85) 100%);
  }

  .cv-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .cv-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .cv-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .roles-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .item-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .item-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .item-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .cv-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .cv-image--second {
    margin-top: 12px;
  }

  .cv-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* What we look for */
  .lookfor-inner {
    max-width: 680px;
    margin-inline: auto;
  }

  .lookfor-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .lookfor-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 18px 22px;
  }

  .lookfor-item__check {
    width: 32px;
    height: 32px;
    background-color: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    flex-shrink: 0;
  }

  .lookfor-item p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
    margin-bottom: 0;
    padding-top: 6px;
  }

  .apply-note {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .apply-note p {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0;
    line-height: 1.6;
    flex: 1;
    min-width: 200px;
  }
</style>
