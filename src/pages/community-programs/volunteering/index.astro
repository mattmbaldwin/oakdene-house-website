---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTABand from '../../../components/CTABand.astro';
import Prose from '../../../components/Prose.astro';
import { pageContent, fieldSource } from '../../../lib/pages';

// Words and images: src/content/pages/community-programs--volunteering.yaml (edited in /admin).
const ID = 'community-programs--volunteering';
const page = await pageContent(ID, 'volunteering');
const { seo, hero, why, types, expect, form, cta } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="vol-hero" aria-labelledby="vol-hero-heading">
    <div class="vol-hero__overlay" aria-hidden="true"></div>
    <div class="container vol-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1 id="vol-hero-heading">{hero.heading}</h1>
      <p class="vol-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- WHY VOLUNTEER -->
  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{why.heading.eyebrow}</p>
            <h2 id="why-heading">{why.heading.heading}</h2>
          </div>
          <p><Prose md={why.paragraph} source={src('why.paragraph')} /></p>
          <ul class="reasons-list">
            {why.reasons.map((r, i) => <li><Prose md={r} source={src(`why.reasons.${i}`)} /></li>)}
          </ul>
          <a href={why.button.href} class="btn btn--primary">{why.button.label}</a>
        </div>
        <div>
          <div class="vol-image">
            <img src={why.image.src} alt={why.image.alt} loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VOLUNTEERING TYPES -->
  <section class="section section--tint" aria-labelledby="types-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{types.heading.eyebrow}</p>
        <h2 id="types-heading">{types.heading.heading}</h2>
      </div>
      <div class="types-grid">
        {types.cards.map((t, i) => (
          <article class="type-card">
            <div class="type-card__image">
              <img src={t.image.src} alt={t.image.alt} loading="lazy" />
            </div>
            <div class="type-card__body">
              <h3 class="type-card__heading">{t.heading}</h3>
              <p class="type-card__desc"><Prose md={t.description} source={src(`types.cards.${i}.description`)} /></p>
              <a href={t.href} class="btn btn--secondary">{types.learnMoreLabel}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT TO EXPECT -->
  <section class="section" aria-labelledby="expect-heading">
    <div class="container">
      <div class="expect-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{expect.heading.eyebrow}</p>
          <h2 id="expect-heading">{expect.heading.heading}</h2>
        </div>
        <div class="expect-grid">
          <div class="expect-item">
            <div class="expect-item__number" aria-hidden="true">01</div>
            <h3>{expect.steps[0].heading}</h3>
            <p><Prose md={expect.steps[0].body} source={src('expect.steps.0.body')} /></p>
          </div>
          <div class="expect-item">
            <div class="expect-item__number" aria-hidden="true">02</div>
            <h3>{expect.steps[1].heading}</h3>
            <p><Prose md={expect.steps[1].body} source={src('expect.steps.1.body')} /></p>
          </div>
          <div class="expect-item">
            <div class="expect-item__number" aria-hidden="true">03</div>
            <h3>{expect.steps[2].heading}</h3>
            <p><Prose md={expect.steps[2].body} source={src('expect.steps.2.body')} /></p>
          </div>
          <div class="expect-item">
            <div class="expect-item__number" aria-hidden="true">04</div>
            <h3>{expect.steps[3].heading}</h3>
            <p><Prose md={expect.steps[3].body} source={src('expect.steps.3.body')} /></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VOLUNTEER FORM -->
  <section class="section section--tint" id="volunteer-form" aria-labelledby="vol-form-heading">
    <div class="container">
      <div class="vol-form-inner">
        <h2 id="vol-form-heading">{form.heading}</h2>
        <p class="vol-form-intro"><Prose md={form.intro} source={src('form.intro')} /></p>
        <iframe
          id="JotFormIFrame-260837985458072"
          title="Volunteer application — Oakdene House Foundation"
          src="https://form.jotform.com/260837985458072"
          class="jotform-embed"
          frameborder="0"
          scrolling="no"
          allow="geolocation; microphone; camera; fullscreen"
        ></iframe>
        <script is:inline src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
        <script is:inline>window.jotformEmbedHandler("iframe[id='JotFormIFrame-260837985458072']", "https://form.jotform.com/");</script>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .vol-hero {
    position: relative;
    min-height: 420px;
    background-image: url('/images/volunteers/oakdene-volunteer-kitchen-1.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .vol-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.85) 100%);
  }

  .vol-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 64px;
    max-width: 680px;
  }

  .vol-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 16px;
  }

  .vol-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    line-height: 1.65;
    margin-bottom: 0;
  }

  .reasons-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    list-style: none;
    margin: 24px 0 32px;
  }

  .reasons-list li {
    padding-left: 28px;
    position: relative;
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .reasons-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .vol-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .vol-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Types */
  .types-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .type-card {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .type-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .type-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .type-card:hover .type-card__image img {
    transform: scale(1.04);
  }

  .type-card__body {
    padding: 28px;
  }

  .type-card__heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .type-card__desc {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  /* Expect steps */
  .expect-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .expect-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .expect-item {
    text-align: center;
  }

  .expect-item__number {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.6;
    line-height: 1;
    margin-bottom: 12px;
  }

  .expect-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .expect-item p {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .types-grid { grid-template-columns: 1fr; }
    .expect-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .expect-grid { grid-template-columns: 1fr; }
  }

  /* Volunteer form section */
  .vol-form-inner {
    max-width: 760px;
    margin-inline: auto;
  }

  .vol-form-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .vol-form-intro {
    font-size: 1.0625rem;
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .jotform-embed {
    display: block;
    width: 100%;
    min-height: 539px;
    border: none;
  }
</style>
