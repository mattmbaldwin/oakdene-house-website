---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTABand from '../../../components/CTABand.astro';
import Prose from '../../../components/Prose.astro';
import { pageContent, fieldSource } from '../../../lib/pages';

// Words and images: src/content/pages/community-programs--volunteering--corporate-volunteering.yaml (edited in /admin).
const ID = 'community-programs--volunteering--corporate-volunteering';
const page = await pageContent(ID, 'corporate-volunteering');
const { seo, hero, overview, why, cta } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="corp-hero" aria-label="Corporate Volunteering">
    <div class="corp-hero__overlay" aria-hidden="true"></div>
    <div class="container corp-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/volunteering/">Volunteering</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="corp-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section" aria-labelledby="corp-overview-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{overview.heading.eyebrow}</p>
            <h2 id="corp-overview-heading">{overview.heading.heading}</h2>
          </div>
          {overview.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`overview.paragraphs.${i}`)} /></p></>)}

          <h3 class="opps-heading">{overview.oppsHeading}</h3>
          <ul class="opps-list">
            {overview.opportunities.map((o, i) => <li><Prose md={o} source={src(`overview.opportunities.${i}`)} /></li>)}
          </ul>
        </div>
        <div class="corp-aside">
          <div class="corp-image">
            <img src={overview.image.src} alt={overview.image.alt} loading="lazy" />
          </div>
          <div class="contact-prompt">
            <h3>{overview.contact.heading}</h3>
            <p><Prose md={overview.contact.text} source={src('overview.contact.text')} /></p>
            <div class="btn-group">
              <a href={overview.contact.primary.href} class="btn btn--primary">{overview.contact.primary.label}</a><!-- TODO: Replace with live Jotform URL -->
              <a href={overview.contact.secondary.href} class="btn btn--secondary">{overview.contact.secondary.label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY PARTNER WITH OAKDENE -->
  <section class="section section--tint" aria-labelledby="why-heading">
    <div class="container">
      <div class="why-inner">
        <div class="section-heading section-heading--center">
          <p class="section-heading__eyebrow">{why.heading.eyebrow}</p>
          <h2 id="why-heading">{why.heading.heading}</h2>
        </div>
        <div class="why-grid">
          <div class="why-item">
            <div class="why-item__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>{why.items[0].heading}</h3>
            <p><Prose md={why.items[0].body} source={src('why.items.0.body')} /></p>
          </div>
          <div class="why-item">
            <div class="why-item__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3>{why.items[1].heading}</h3>
            <p><Prose md={why.items[1].body} source={src('why.items.1.body')} /></p>
          </div>
          <div class="why-item">
            <div class="why-item__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>{why.items[2].heading}</h3>
            <p><Prose md={why.items[2].body} source={src('why.items.2.body')} /></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .corp-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/volunteers/oakdene-volunteer-kitchen-3a.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .corp-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.45) 0%, rgba(0,62,81,0.88) 100%);
  }

  .corp-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .corp-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .corp-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .opps-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .opps-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .opps-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .opps-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .corp-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .corp-image {
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .corp-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-prompt {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px;
  }

  .contact-prompt h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .contact-prompt p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  /* Why */
  .why-inner {
    max-width: 860px;
    margin-inline: auto;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .why-item {
    background-color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 24px;
    border: 1px solid var(--color-secondary);
  }

  .why-item__icon {
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .why-item h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .why-item p {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
