---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import hours from '../../content/opening-hours.json';
import { pageContent, fieldSource } from '../../lib/pages';
import { detailRows, fillHours } from '../../lib/service-details';

// Words and images: src/content/pages/community-programs--oakdene-laundrette.yaml (edited in /admin).
// The days, hours and last entry come from src/content/opening-hours.json.
const ID = 'community-programs--oakdene-laundrette';
const page = await pageContent(ID, 'oakdene-laundrette');
const { seo, hero, intro, photos, how, group, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const serviceRows = detailRows(ID, intro.details, [
  ['days', hours.laundrette.days],
  ['hours', hours.laundrette.hours],
  ['lastEntry', hours.laundrette.lastEntry],
]);
---

<BaseLayout
  title={seo.title}
  description={fillHours(seo.description, hours.laundrette.seoDescription)}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="laundry-hero" aria-label="Oakdene Laundrette">
    <div class="laundry-hero__overlay" aria-hidden="true"></div>
    <div class="container laundry-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/community-programs/">Community Programs</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="laundry-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- INTRO + DETAILS -->
  <section class="section" aria-labelledby="laundry-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{intro.heading.eyebrow}</p>
            <h2 id="laundry-intro-heading">{intro.heading.heading}</h2>
          </div>
          <p><Prose md={intro.paragraph} source={src('intro.paragraph')} /></p>

          <h3 class="offer-heading">{intro.includedHeading}</h3>
          <ul class="offer-list">
            {intro.includedItems.map((item, i) => <li><Prose md={item} source={src(`intro.includedItems.${i}`)} /></li>)}
          </ul>
        </div>
        <div>
          <InfoTable rows={serviceRows} caption={intro.details.caption} />
        </div>
      </div>
    </div>
  </section>

  <!-- LAUNDRETTE IMAGES -->
  <section class="laundry-images" aria-label="Oakdene Laundrette photos">
    <div class="container">
      <div class="image-strip">
        <div class="image-strip__item">
          <img src={photos[0].src} alt={photos[0].alt} loading="lazy" />
        </div>
        <div class="image-strip__item">
          <img src={photos[1].src} alt={photos[1].alt} loading="lazy" />
        </div>
        <div class="image-strip__item">
          <img src={photos[2].src} alt={photos[2].alt} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="narrow">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{how.heading.eyebrow}</p>
          <h2 id="how-heading">{how.heading.heading}</h2>
        </div>
        <ol class="steps-list">
          {how.steps.map((step, i) => (
            <li class="steps-list__item">
              <div class="steps-list__number" aria-hidden="true">{i + 1}</div>
              <p class="steps-list__text"><Prose md={step} source={src(`how.steps.${i}`)} /></p>
            </li>
          ))}
        </ol>

        <div class="eligibility-box">
          <h3>{how.eligibility.heading}</h3>
          <p><Prose md={how.eligibility.text} source={src('how.eligibility.text')} /></p>
        </div>
      </div>
    </div>
  </section>

  <!-- GROUP BOOKINGS -->
  <section class="section section--tint" aria-labelledby="group-heading">
    <div class="container">
      <div class="group-split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{group.heading.eyebrow}</p>
            <h2 id="group-heading">{group.heading.heading}</h2>
          </div>
          <p><Prose md={fillHours(group.text, hours.laundrette.groupBookingDays)} source={src('group.text')} /></p>
        </div>
        <div class="group-details">
          <div class="group-detail-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span><Prose md={group.points[0]} source={src('group.points.0')} /></span>
          </div>
          <div class="group-detail-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><Prose md={group.points[1]} source={src('group.points.1')} /></span>
          </div>
          <div class="group-detail-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            <span><Prose md={group.points[2]} source={src('group.points.2')} /></span>
          </div>
          <div class="group-detail-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span><Prose md={group.points[3]} source={src('group.points.3')} /></span>
          </div>
          <a href={group.button.href} class="btn btn--primary group-btn">{group.button.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  .laundry-hero {
    position: relative;
    min-height: 400px;
    background-image: url('/images/laundrette/laundrette-interior-1.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .laundry-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.85) 100%);
  }

  .laundry-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .laundry-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .laundry-hero__lead {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 0;
    max-width: 520px;
  }

  .offer-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .offer-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .offer-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  /* Image strip */
  .laundry-images {
    padding-block: 0;
    background-color: var(--color-tint);
  }

  .image-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .image-strip__item {
    height: 280px;
    overflow: hidden;
  }

  .image-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-strip__item:hover img {
    transform: scale(1.04);
  }

  /* Steps */
  .narrow {
    max-width: 720px;
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
    margin-bottom: 32px;
  }

  .steps-list__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-secondary);
  }

  .steps-list__item:last-child {
    border-bottom: none;
  }

  .steps-list__number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-weight: 700;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .steps-list__text {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
    padding-top: 5px;
  }

  .eligibility-box {
    background-color: var(--color-tint);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-secondary);
    padding: 24px 28px;
  }

  .eligibility-box h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .eligibility-box p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Group bookings */
  .group-split {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    align-items: start;
  }

  .group-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .group-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .group-detail-item svg {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .group-btn {
    margin-top: 8px;
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .group-split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .image-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .image-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
