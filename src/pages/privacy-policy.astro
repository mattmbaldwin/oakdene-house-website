---
import pageText from '../content/pages/privacy-policy.json';
import { inlineMarkdown } from '../lib/format';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
>

  <!-- HERO -->
  <section class="legal-hero" aria-label="Privacy Policy">
    <div class="container legal-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Privacy Policy</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
    </div>
  </section>

  <!-- DOCUMENT BODY -->
  <section class="section" aria-label="Privacy Policy content">
    <div class="container">
      <div class="doc-wrap">

        <!-- Notice title + intro -->
        <div class="doc-section">
          <p class="doc-notice-label">{pageText.notice_title_intro__text}</p>
          <p>{pageText.notice_title_intro__text_2}</p>
        </div>

        <!-- Version -->
        <div class="doc-meta">
          <p set:html={inlineMarkdown(pageText.version__text)}></p>
        </div>

        <!-- Who we are -->
        <div class="doc-section">
          <h2>{pageText.who_we_are__heading}</h2>
          <p>{pageText.who_we_are__text}</p>
          <p>{pageText.who_we_are__text_2}</p>
          <p>{pageText.who_we_are__text_3}</p>
        </div>

        <!-- What information -->
        <div class="doc-section">
          <h2>{pageText.what_information__heading}</h2>
          <p>{pageText.what_information__text}</p>
          <ul>
{pageText.what_information__list.map((item) => <li>{item}</li>)}
</ul>
          <div class="doc-address">
            <p set:html={inlineMarkdown(pageText.what_information__text_2)}></p>
            <p>{pageText.what_information__text_3}</p>
          </div>
        </div>

        <!-- Using our website -->
        <div class="doc-section">
          <h2>{pageText.using_our_website__heading}</h2>
          <p>{pageText.using_our_website__text}</p>
          <p>{pageText.using_our_website__text_2}</p>
        </div>

        <!-- Why collect -->
        <div class="doc-section">
          <h2>{pageText.why_collect__heading}</h2>
          <p>{pageText.why_collect__text}</p>
          <ul>
{pageText.why_collect__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.why_collect__text_2}</p>
        </div>

        <!-- Who can see -->
        <div class="doc-section">
          <h2>{pageText.who_can_see__heading}</h2>
          <p>{pageText.who_can_see__text}</p>
          <ul>
{pageText.who_can_see__list.map((item) => <li>{item}</li>)}
</ul>
          <div class="doc-address">
            <p set:html={inlineMarkdown(pageText.who_can_see__text_2)}></p>
            <p>{pageText.who_can_see__text_3}</p>
          </div>
          <p>{pageText.who_can_see__text_4}</p>
        </div>

        <!-- Confidential -->
        <div class="doc-section">
          <h2>{pageText.confidential__heading}</h2>
          <p>{pageText.confidential__text}</p>
          <p>{pageText.confidential__text_2}</p>
          <ul>
{pageText.confidential__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.confidential__text_3}</p>
        </div>

        <!-- Rights -->
        <div class="doc-section">
          <h2>{pageText.rights__heading}</h2>
          <p>{pageText.rights__text}</p>
          <ul>
{pageText.rights__list.map((item) => <li>{item}</li>)}
</ul>
          <p>{pageText.rights__text_2}</p>
        </div>

        <!-- Anonymous -->
        <div class="doc-section">
          <h2>{pageText.anonymous__heading}</h2>
          <p>{pageText.anonymous__text}</p>
          <p>{pageText.anonymous__text_2}</p>
        </div>

        <!-- How we keep safe -->
        <div class="doc-section">
          <h2>{pageText.how_we_keep_safe__heading}</h2>
          <p>{pageText.how_we_keep_safe__text}</p>
          <ul>
{pageText.how_we_keep_safe__list.map((item) => <li>{item}</li>)}
</ul>
        </div>

        <!-- How long -->
        <div class="doc-section">
          <h2>{pageText.how_long__heading}</h2>
          <p>{pageText.how_long__text}</p>
          <p>{pageText.how_long__text_2}</p>
        </div>

        <!-- Concern/complaint -->
        <div class="doc-section">
          <h2>{pageText.concern_complaint__heading}</h2>
          <p>{pageText.concern_complaint__text}</p>
          <ul>
{pageText.concern_complaint__list.map((item) => <li set:html={inlineMarkdown(item)} />)}
</ul>
          <p>{pageText.concern_complaint__text_2}</p>
        </div>

        <!-- Contact card -->
        <div class="doc-address doc-contact-card">
          <p set:html={inlineMarkdown(pageText.contact_card__text)}></p>
          <p>{pageText.contact_card__text_2}</p>
          <p>{pageText.contact_card__text_3}</p>
          <p set:html={inlineMarkdown(pageText.contact_card__text_4)}></p>
          <p set:html={inlineMarkdown(pageText.contact_card__text_5)}></p>
        </div>

        <!-- Closing -->
        <div class="doc-section">
          <p>{pageText.closing__text}</p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .legal-hero {
    background-color: var(--color-primary);
    padding-block: 52px 44px;
  }

  .legal-hero h1 {
    color: var(--color-white);
    margin-bottom: 0;
  }

  /* ---- Document wrapper ---- */
  .doc-wrap {
    max-width: 760px;
    margin-inline: auto;
  }

  /* ---- Notice label ---- */
  .doc-notice-label {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  /* ---- Dates metadata ---- */
  .doc-meta {
    padding: 18px 22px;
    background-color: var(--color-tint);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    margin-bottom: 36px;
  }

  .doc-meta p {
    margin-bottom: 4px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .doc-meta p:last-child {
    margin-bottom: 0;
  }

  /* ---- Document sections ---- */
  .doc-section {
    margin-bottom: 48px;
  }

  .doc-section:last-child {
    margin-bottom: 0;
  }

  .doc-section h2 {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-secondary);
  }

  .doc-section p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .doc-section p:last-child {
    margin-bottom: 0;
  }

  .doc-section ul {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .doc-section li {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 7px;
  }

  .doc-section :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .doc-section :global(a:hover) {
    color: var(--color-link-hover);
  }

  /* ---- Callout / address / contact card ---- */
  .doc-address {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .doc-address p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .doc-address p:last-child {
    margin-bottom: 0;
  }

  .doc-address :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .doc-address :global(a:hover) {
    text-decoration: underline;
  }

  .doc-contact-card {
    margin-bottom: 32px;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
  }
</style>
