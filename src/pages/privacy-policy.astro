---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { pageContent, fieldSource } from '../lib/pages';

// Words: src/content/pages/privacy-policy.yaml (edited in /admin).
const ID = 'privacy-policy';
const page = await pageContent(ID, 'privacy-policy');
const { seo, hero, notice, version, sections, contactCard, closing } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="legal-hero" aria-label="Privacy Policy">
    <div class="container legal-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
    </div>
  </section>

  <!-- DOCUMENT BODY -->
  <section class="section" aria-label="Privacy Policy content">
    <div class="container">
      <div class="doc-wrap">

        <!-- Notice title + intro -->
        <div class="doc-section">
          <p class="doc-notice-label">{notice.label}</p>
          <p><Prose md={notice.text} source={src('notice.text')} /></p>
        </div>

        <!-- Version -->
        <div class="doc-meta">
          <p><em>{version}</em></p>
        </div>

        {sections.map((s, si) => <>{' '}<div class="doc-section">{' '}<h2>{s.heading}</h2>{s.blocks.map((b, bi) => <>{' '}{b.paragraph !== undefined ? <p><Prose md={b.paragraph} source={src(`sections.${si}.blocks.${bi}.paragraph`)} /></p> : b.items ? <ul>{b.items.map((it, ii) => <>{' '}<li><Prose md={it} source={src(`sections.${si}.blocks.${bi}.items.${ii}`)} /></li></>)}{' '}</ul> : b.callout ? <div class="doc-address">{' '}<p><strong>{b.callout.heading}</strong></p>{b.callout.lines.map((l, li) => <>{' '}<p><Prose md={l} source={src(`sections.${si}.blocks.${bi}.callout.lines.${li}`)} /></p></>)}{' '}</div> : <div class="doc-address doc-contact-card">{' '}<p><strong>{b.contactCard.heading}</strong></p>{b.contactCard.lines.map((l, li) => <>{' '}<p><Prose md={l} source={src(`sections.${si}.blocks.${bi}.contactCard.lines.${li}`)} /></p></>)}{' '}</div>}</>)}{' '}</div></>)}

        <!-- Contact card -->
        <div class="doc-address doc-contact-card">
          <p><strong>{contactCard.heading}</strong></p>
          {contactCard.lines.map((l, li) => <>{' '}<p><Prose md={l} source={src(`contactCard.lines.${li}`)} /></p></>)}
        </div>

        <!-- Closing -->
        <div class="doc-section">
          <p><Prose md={closing} source={src('closing')} /></p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .legal-hero {
    background-color: var(--color-primary);
    padding-block: 52px 44px;
  }

  .legal-hero h1 {
    color: var(--color-white);
    margin-bottom: 0;
  }

  /* ---- Document wrapper ---- */
  .doc-wrap {
    max-width: 760px;
    margin-inline: auto;
  }

  /* ---- Notice label ---- */
  .doc-notice-label {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  /* ---- Dates metadata ---- */
  .doc-meta {
    padding: 18px 22px;
    background-color: var(--color-tint);
    border-left: 3px solid var(--color-secondary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    margin-bottom: 36px;
  }

  .doc-meta p {
    margin-bottom: 4px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .doc-meta p:last-child {
    margin-bottom: 0;
  }

  /* ---- Document sections ---- */
  .doc-section {
    margin-bottom: 48px;
  }

  .doc-section:last-child {
    margin-bottom: 0;
  }

  .doc-section h2 {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-secondary);
  }

  .doc-section p {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .doc-section p:last-child {
    margin-bottom: 0;
  }

  .doc-section ul {
    padding-left: 22px;
    margin-bottom: 16px;
  }

  .doc-section li {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.65;
    margin-bottom: 7px;
  }

  .doc-section a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .doc-section a:hover {
    color: var(--color-link-hover);
  }

  /* ---- Callout / address / contact card ---- */
  .doc-address {
    background-color: var(--color-tint);
    border: 1px solid var(--color-secondary);
    border-radius: var(--radius-card);
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .doc-address p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .doc-address p:last-child {
    margin-bottom: 0;
  }

  .doc-address a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .doc-address a:hover {
    text-decoration: underline;
  }

  .doc-contact-card {
    margin-bottom: 32px;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
  }
</style>
