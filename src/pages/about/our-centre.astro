---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoTable from '../../components/InfoTable.astro';
import CTABand from '../../components/CTABand.astro';
import Prose from '../../components/Prose.astro';
import { pageContent, fieldSource } from '../../lib/pages';

// Words and images: src/content/pages/about--our-centre.yaml (edited in /admin).
const ID = 'about--our-centre';
const page = await pageContent(ID, 'our-centre');
const { seo, hero, intro, gallery, location, directions, cta } = page;
const src = (path: string) => fieldSource(ID, path);

// InfoTable shows its values as HTML, so plain text from the editor is escaped before it goes in.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const attr = (t: string) => esc(t).replace(/"/g, '&quot;');
const locationRows = [
  { label: 'Address', value: esc(location.address) },
  { label: 'Phone',   value: `<a href="${attr(location.phone.href)}">${esc(location.phone.label)}</a>` },
  { label: 'Email',   value: `<a href="${attr(location.email.href)}">${esc(location.email.label)}</a>` },
  { label: 'Parking', value: esc(location.parking) },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="centre-hero" aria-label="Our Centre">
    <div class="centre-hero__overlay" aria-hidden="true"></div>
    <div class="container centre-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/about/">About</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="centre-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- INTRO + WHAT TO EXPECT -->
  <section class="section" aria-labelledby="centre-intro-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{intro.heading.eyebrow}</p>
            <h2 id="centre-intro-heading">{intro.heading.heading}</h2>
          </div>
          {intro.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`intro.paragraphs.${i}`)} /></p></>)}
          <h3 class="expect-heading">{intro.expectHeading}</h3>
          <ul class="expect-list">
            {intro.expectItems.map((item, i) => <li><Prose md={item} source={src(`intro.expectItems.${i}`)} /></li>)}
          </ul>
        </div>
        <div class="split__image">
          <img
            src={intro.image.src}
            alt={intro.image.alt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section section--tint" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{gallery.heading.eyebrow}</p>
        <h2 id="gallery-heading">{gallery.heading.heading}</h2>
      </div>
      <div class="centre-gallery">
        {gallery.images.map((img, i) => (
          <div class={`gallery-item gallery-item--${i + 1}`}>
            <img src={img.src} alt={img.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section" aria-labelledby="location-heading">
    <div class="container">
      <div class="split split--image-right">
        <div class="split__image">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3312.61101941524!2d150.95640981079958!3d-33.87391421921127!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b12bd8662e9407d%3A0x170a8d432084875b!2s29%20Vine%20St%2C%20Fairfield%20NSW%202165!5e0!3m2!1sen!2sau!4v1776071548440!5m2!1sen!2sau"
            width="100%"
            height="400"
            style="border:0; border-radius: 12px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={location.mapTitle}
          ></iframe>
          <a
            href={location.mapLink.href}
            target="_blank"
            rel="noopener noreferrer"
            class="maps-link"
          >
            {location.mapLink.label}
          </a>
        </div>
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{location.heading.eyebrow}</p>
            <h2 id="location-heading">{location.heading.heading}</h2>
          </div>
          <InfoTable rows={locationRows} />
        </div>
      </div>
    </div>
  </section>

  <!-- DIRECTIONS DOWNLOAD -->
  <section class="directions-download">
    <div class="container">
      <div class="directions-card">
        <h3>{directions.heading}</h3>
        <p><Prose md={directions.text} source={src('directions.text')} /></p>
        <a href={directions.button.href} class="btn btn--primary" download>
          {directions.button.label}
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    subheading={cta.subheading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  /* Hero */
  .centre-hero {
    position: relative;
    min-height: 380px;
    background-image: url('/images/centre/exterior-exterior-1-img_2651.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }

  .centre-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.35) 0%, rgba(0,62,81,0.82) 100%);
  }

  .centre-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .centre-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .centre-hero__lead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.85);
    max-width: 560px;
    margin-bottom: 0;
  }

  /* Expect list */
  .expect-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 24px 0 14px;
  }

  .expect-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .expect-list li {
    padding-left: 24px;
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .expect-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  /* Gallery */
  .centre-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .gallery-item {
    overflow: hidden;
    border-radius: var(--radius-card);
    height: 260px;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.04);
  }

  /* Maps link */
  .maps-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }

  .maps-link:hover {
    text-decoration: underline;
  }

  /* Directions download */
  .directions-download {
    padding: 3rem 0 4rem;
  }

  .directions-card {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem;
    background: var(--color-tint);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-card);
  }

  .directions-card h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .directions-card p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .centre-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .centre-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
