---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import people from '../../content/team.json';
import pageText from '../../content/pages/about-our-team.json';

const { team, patrons } = people;
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/team/colour-mark-facing-camera.jpg"
>

  <!-- HERO -->
  <section class="team-hero" aria-label="Our Team">
    <div class="container team-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/about/">About</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Our Team</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="team-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section" aria-labelledby="team-intro-heading">
    <div class="container intro-container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.intro__eyebrow}</p>
        <h2 id="team-intro-heading">{pageText.intro__heading}</h2>
      </div>
      <p class="intro-lead">{pageText.intro__intro}</p>
    </div>
  </section>

  <!-- TEAM GRID -->
  <section class="section section--tint" aria-label="Our team members">
    <div class="container">
      <div class="team-grid">
        {team.map(member => (
          <article class="team-card">
            <div class="team-card__photo">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={`${member.name} — ${member.role}`}
                  loading="lazy"
                />
              ) : (
                <div class="team-card__initials" aria-hidden="true">
                  {member.initials}
                </div>
              )}
            </div>
            <div class="team-card__body">
              <h3 class="team-card__name">{member.name}</h3>
              <p class="team-card__role">{member.role}</p>
              <p class="team-card__bio">{member.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PATRONS -->
  <section class="section" aria-labelledby="patrons-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.patrons__eyebrow}</p>
        <h2 id="patrons-heading">{pageText.patrons__heading}</h2>
      </div>
      <div class="patrons-grid">
        {patrons.map(patron => (
          <article class="patron-card">
            <div class="patron-card__photo">
              <img
                src={patron.photo}
                alt={patron.name}
                loading="lazy"
              />
            </div>
            <div class="patron-card__body">
              <h3 class="patron-card__name">{patron.name}</h3>
              <p class="patron-card__role">{patron.role}</p>
              <p class="patron-card__bio">{patron.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="section section--tint" aria-labelledby="team-closing-heading">
    <div class="container closing-container">
      <h2 id="team-closing-heading" class="visually-hidden">{pageText.closing__heading}</h2>
      <p class="closing-text">{pageText.closing__text}</p>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    subheading={pageText.cta__subheading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  /* Hero */
  .team-hero {
    background-color: var(--color-primary);
    padding-block: 72px 64px;
  }

  .team-hero__content h1 { color: var(--color-white); margin-bottom: 10px; }

  .team-hero__lead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.85);
    margin-bottom: 0;
  }

  /* Intro */
  .intro-container {
    max-width: 720px;
  }

  .intro-lead {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    text-align: center;
    margin-bottom: 0;
  }

  /* Team grid — 2 columns to give bio text room */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .team-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: grid;
    grid-template-columns: 160px 1fr;
  }

  .team-card__photo {
    width: 160px;
    background-color: var(--color-tint);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .team-card__photo img:hover {
    filter: grayscale(0%);
  }

  .team-card__initials {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: 1.25rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
  }

  .team-card__body {
    padding: 24px;
  }

  .team-card__name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .team-card__role {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary-hover);
    margin-bottom: 14px;
  }

  .team-card__bio {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin-bottom: 0;
  }

  /* Patrons grid */
  .patrons-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .patron-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    border-top: 3px solid var(--color-primary);
    display: grid;
    grid-template-columns: 200px 1fr;
  }

  .patron-card__photo {
    width: 200px;
    background-color: var(--color-tint);
    overflow: hidden;
    flex-shrink: 0;
  }

  .patron-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .patron-card__photo img:hover {
    filter: grayscale(0%);
  }

  .patron-card__body {
    padding: 28px;
  }

  .patron-card__name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .patron-card__role {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-hover);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .patron-card__bio {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* Closing */
  .closing-container {
    max-width: 620px;
    text-align: center;
  }

  .closing-text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 0;
    font-style: italic;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .team-grid { grid-template-columns: 1fr; }
    .patrons-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .team-card {
      grid-template-columns: 1fr;
    }

    .team-card__photo {
      width: 100%;
      height: 200px;
    }

    .team-card__initials {
      margin: 48px auto 0;
    }

    .patron-card {
      grid-template-columns: 1fr;
    }

    .patron-card__photo {
      width: 100%;
      height: 240px;
    }
  }
</style>
