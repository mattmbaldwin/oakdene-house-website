---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import Prose from '../../components/Prose.astro';
import { pageContent, fieldSource } from '../../lib/pages';

// Video details come from the launch pack, read at build time only.
import video from '../../../docs/video-launch/content/video.json';

// Words and images: src/content/pages/about--the-oakdene-story.yaml (edited in /admin).
// The film itself (video id, title, thumbnail, transcript page) stays in docs/video-launch.
const ID = 'about--the-oakdene-story';
const page = await pageContent(ID, 'the-oakdene-story');
const { seo, hero, story, strip, film, why, cta } = page;
const src = (path: string) => fieldSource(ID, path);

const videoThumbnail = video.thumbnail_path.replace(/^public/, '');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
>

  <!-- HERO -->
  <section class="story-hero" aria-label="The Oakdene Story">
    <div class="story-hero__overlay" aria-hidden="true"></div>
    <div class="container story-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/about/">About</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
      <p class="story-hero__lead"><Prose md={hero.lead} source={src('hero.lead')} /></p>
    </div>
  </section>

  <!-- STORY — SPLIT -->
  <section class="section" aria-labelledby="story-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{story.heading.eyebrow}</p>
            <h2 id="story-heading">{story.heading.heading}</h2>
          </div>
          {story.paragraphs.map((p, i) => <>{i > 0 && ' '}<p><Prose md={p} source={src(`story.paragraphs.${i}`)} /></p></>)}
        </div>
        <div class="split__image">
          <img
            src={story.image.src}
            alt={story.image.alt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- TREE IMAGE STRIP -->
  <div class="tree-strip" aria-hidden="true">
    {strip.map((photo, i) => <>{i > 0 && ' '}<div class="tree-strip__image">
      <div style="border-radius: 12px; overflow: hidden; width: 100%; height: 100%;">
        <img src={photo} alt="" loading="lazy" />
      </div>
    </div></>)}
  </div>

  <!-- WATCH OUR STORY -->
  <section class="section" aria-labelledby="watch-heading">
    <div class="container story-video">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{film.heading.eyebrow}</p>
        <h2 id="watch-heading">{film.heading.heading}</h2>
        <p class="section-heading__lead"><Prose md={film.heading.lead} source={src('film.heading.lead')} /></p>
      </div>
      <VideoPlayer
        youtubeId={video.youtube_id}
        title={video.title}
        thumbnail={videoThumbnail}
        label={film.playLabel}
      />
      <p class="story-video__link">
        <a href={video.watch_page_path}>{film.transcriptLink}</a>
      </p>
    </div>
  </section>

  <!-- WHY THIS MATTERS -->
  <section class="section section--dark" aria-labelledby="why-heading">
    <div class="container why-container">
      <p class="section-heading__eyebrow">{why.label}</p>
      <blockquote class="why-quote">
        <p id="why-heading">"{why.quote}"</p>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={cta.heading}
    primaryBtn={{ text: cta.primary.label, href: cta.primary.href }}
    secondaryBtn={{ text: cta.secondary.label, href: cta.secondary.href }}
    dark={true}
  />

</BaseLayout>

<style>
  /* Hero */
  .story-hero {
    position: relative;
    min-height: 420px;
    background-image: url('/images/about/oakdene-tree-hero-colour.jpg');
    background-size: cover;
    background-position: center center;
    display: flex;
    align-items: flex-end;
  }

  .story-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.78) 100%);
  }

  .story-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .story-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .story-hero__lead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.85);
    max-width: 520px;
    margin-bottom: 0;
  }

  /* Story body text */
  .split p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .split__image img {
    object-position: center center;
  }

  /* Tree strip */
  /* Watch our story */
  .story-video {
    max-width: 880px;
  }

  .story-video__link {
    margin-top: 20px;
    margin-bottom: 0;
    text-align: center;
  }

  .story-video__link a {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition);
  }

  .story-video__link a:hover {
    color: var(--color-link-hover);
  }

  .tree-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 420px;
    background-color: var(--color-tint);
    padding: var(--section-padding-desktop) 1.5rem;
    gap: 12px;
  }

  .tree-strip__image {
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .tree-strip__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity var(--transition);
  }

  .tree-strip__image:hover img {
    opacity: 1;
  }

  /* Why quote */
  .why-container {
    max-width: 720px;
    text-align: center;
  }

  .why-quote {
    margin: 20px 0 0;
  }

  .why-quote p {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255,255,255,0.92);
    font-style: italic;
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .tree-strip {
      grid-template-columns: 1fr;
      height: auto;
      padding: var(--section-padding-mobile) 1.5rem;
    }

    .tree-strip__image {
      height: 200px;
    }
  }
</style>
