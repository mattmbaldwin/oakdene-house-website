---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import pageText from '../../content/pages/about-the-oakdene-story.json';

// Video details come from the launch pack, read at build time only.
import video from '../../../docs/video-launch/content/video.json';

const videoThumbnail = video.thumbnail_path.replace(/^public/, '');
---

<BaseLayout
  title={pageText.seo__browser_title}
  description={pageText.seo__search_description}
  ogImage="/images/about/colour-oakdene-tree-panorama.jpg"
>

  <!-- HERO -->
  <section class="story-hero" aria-label="The Oakdene Story">
    <div class="story-hero__overlay" aria-hidden="true"></div>
    <div class="container story-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/about/">About</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">The Oakdene Story</span>
      </nav>
      <h1>{pageText.hero__title}</h1>
      <p class="story-hero__lead">{pageText.hero__intro}</p>
    </div>
  </section>

  <!-- STORY — SPLIT -->
  <section class="section" aria-labelledby="story-heading">
    <div class="container">
      <div class="split">
        <div>
          <div class="section-heading">
            <p class="section-heading__eyebrow">{pageText.story__eyebrow}</p>
            <h2 id="story-heading">{pageText.story__heading}</h2>
          </div>
          <p>{pageText.story__text}</p>
          <p>{pageText.story__text_2}</p>
          <p>{pageText.story__text_3}</p>
          <p>{pageText.story__text_4}</p>
        </div>
        <div class="split__image">
          <img
            src="/images/about/oakdene-tree-sunlight.jpg"
            alt={pageText.story__image_alt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- TREE IMAGE STRIP -->
  <div class="tree-strip" aria-hidden="true">
    <div class="tree-strip__image">
      <div style="border-radius: 12px; overflow: hidden; width: 100%; height: 100%;">
        <img src="/images/about/bandw-oakdene-tree-bottom.jpg" alt="" loading="lazy" />
      </div>
    </div>
    <div class="tree-strip__image">
      <div style="border-radius: 12px; overflow: hidden; width: 100%; height: 100%;">
        <img src="/images/about/bandw-oakdene-tree-leaves-and-base.jpg" alt="" loading="lazy" />
      </div>
    </div>
    <div class="tree-strip__image">
      <div style="border-radius: 12px; overflow: hidden; width: 100%; height: 100%;">
        <img src="/images/about/bandwoakdene-tree-panorama.jpg" alt="" loading="lazy" />
      </div>
    </div>
  </div>

  <!-- WATCH OUR STORY -->
  <section class="section" aria-labelledby="watch-heading">
    <div class="container story-video">
      <div class="section-heading section-heading--center">
        <p class="section-heading__eyebrow">{pageText.watch_our_story__eyebrow}</p>
        <h2 id="watch-heading">{pageText.watch_our_story__heading}</h2>
        <p class="section-heading__lead">{pageText.watch_our_story__intro}</p>
      </div>
      <VideoPlayer
        youtubeId={video.youtube_id}
        title={video.title}
        thumbnail={videoThumbnail}
        label={pageText.watch_our_story__label}
      />
      <p class="story-video__link">
        <a href={video.watch_page_path}>{pageText.watch_our_story__button}</a>
      </p>
    </div>
  </section>

  <!-- WHY THIS MATTERS -->
  <section class="section section--dark" aria-labelledby="why-heading">
    <div class="container why-container">
      <p class="section-heading__eyebrow">{pageText.why_this_matters__eyebrow}</p>
      <blockquote class="why-quote">
        <p id="why-heading">{pageText.why_this_matters__text}</p>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <CTABand
    heading={pageText.cta__heading}
    primaryBtn={pageText.cta__primarybtn}
    secondaryBtn={pageText.cta__secondarybtn}
    dark={true}
  />

</BaseLayout>

<style>
  /* Hero */
  .story-hero {
    position: relative;
    min-height: 420px;
    background-image: url('/images/about/oakdene-tree-hero-colour.jpg');
    background-size: cover;
    background-position: center center;
    display: flex;
    align-items: flex-end;
  }

  .story-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,62,81,0.3) 0%, rgba(0,62,81,0.78) 100%);
  }

  .story-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 56px;
  }

  .story-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .story-hero__lead {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.85);
    max-width: 520px;
    margin-bottom: 0;
  }

  /* Story body text */
  .split p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .split__image img {
    object-position: center center;
  }

  /* Tree strip */
  /* Watch our story */
  .story-video {
    max-width: 880px;
  }

  .story-video__link {
    margin-top: 20px;
    margin-bottom: 0;
    text-align: center;
  }

  .story-video__link :global(a) {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition);
  }

  .story-video__link :global(a:hover) {
    color: var(--color-link-hover);
  }

  .tree-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 420px;
    background-color: var(--color-tint);
    padding: var(--section-padding-desktop) 1.5rem;
    gap: 12px;
  }

  .tree-strip__image {
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .tree-strip__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity var(--transition);
  }

  .tree-strip__image:hover img {
    opacity: 1;
  }

  /* Why quote */
  .why-container {
    max-width: 720px;
    text-align: center;
  }

  .why-quote {
    margin: 20px 0 0;
  }

  .why-quote p {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255,255,255,0.92);
    font-style: italic;
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .tree-strip {
      grid-template-columns: 1fr;
      height: auto;
      padding: var(--section-padding-mobile) 1.5rem;
    }

    .tree-strip__image {
      height: 200px;
    }
  }
</style>
