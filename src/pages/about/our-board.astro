---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { pageContent, fieldSource } from '../../lib/pages';

// Words and images: src/content/pages/about--our-board.yaml (edited in /admin).
const ID = 'about--our-board';
const page = await pageContent(ID, 'our-board');
const { seo, hero, holding } = page;
const src = (path: string) => fieldSource(ID, path);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={seo.image}
  noindex={true}
>

  <!-- HERO -->
  <section class="board-hero" aria-label="Our Board">
    <div class="container board-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/about/">About</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">{hero.breadcrumb}</span>
      </nav>
      <h1>{hero.heading}</h1>
    </div>
  </section>

  <!-- HOLDING MESSAGE -->
  <section class="section" aria-label="Board profiles">
    <div class="container holding-container">
      <h2>{holding.heading}</h2>
      <p><Prose md={holding.message} source={src('holding.message')} /></p>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .board-hero {
    background-color: var(--color-primary);
    padding-block: 72px 64px;
  }

  .board-hero__content h1 {
    color: var(--color-white);
    margin-bottom: 0;
  }

  /* Holding message */
  .holding-container {
    max-width: 680px;
  }

  .holding-container h2 {
    margin-bottom: 16px;
  }

  .holding-container p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .holding-container a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition);
  }

  .holding-container a:hover {
    color: var(--color-link-hover);
  }
</style>
